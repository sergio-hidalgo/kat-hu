{
  "name": "kat-hu",
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "engines": {
    "node": "^24.15.0 || >=26.0.0"
  },
  "packageManager": "pnpm@11.5.2",
  "scripts": {
    "dev": "pnpm --parallel --filter @kat-hu/contracts --filter client --filter server dev",
    "dev:client": "pnpm --filter client dev",
    "dev:server": "pnpm --filter server dev",
    "dev:studio": "pnpm --filter studio dev",
    "build": "pnpm -r build",
    "check": "pnpm -r check",
    "preview": "pnpm --filter client preview",
    "start:server": "pnpm --filter server start",
    "test": "pnpm -r test",
    "perf": "pnpm build && node scripts/perf.mjs",
    "perf:run": "node scripts/perf.mjs",
    "check:compression": "node scripts/check-compression.mjs"
  },
  "devDependencies": {
    "chrome-launcher": "^1.2.2",
    "lighthouse": "^13.5.0"
  }
}
