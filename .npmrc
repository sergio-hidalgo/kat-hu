# The runtime floor (spec 03b) is `engines.node` in every package.json.
# This line is what npm and npx honour. pnpm 11 does NOT read its own settings
# from here any more — it reads `engineStrict: true` from `pnpm-workspace.yaml`,
# which is what actually makes `pnpm install` fail on an unsupported Node.
# Both are deliberate; neither is redundant.
engine-strict=true
