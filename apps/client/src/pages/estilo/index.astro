---
/**
 * The visual regression surface: every `ui/*` primitive in every state, the
 * v2 palette, the botanical drawings in the colours they take, plus a grid
 * demo. Later specs check their work against this page.
 *
 * Dev only. Since spec 04 the site renders on demand, so the guard below is
 * the plain runtime check the previous `getStaticPaths` workaround stood in
 * for: in a production build this route answers 404 like any other address
 * that does not exist.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import Section from '../../components/layout/Section.astro';
import Grid from '../../components/layout/Grid.astro';
import Button from '../../components/ui/Button.astro';
import Card from '../../components/ui/Card.astro';
import Chip from '../../components/ui/Chip.astro';
import Field from '../../components/ui/Field.astro';
import { fieldControlClass } from '../../components/ui/field';
import Flora from '../../components/ui/Flora.astro';
import PressedFlower from '../../components/ui/PressedFlower.astro';
import SectionEdge from '../../components/ui/SectionEdge.astro';
import Testimonial from '../../components/ui/Testimonial.astro';
import Toast from '../../components/ui/Toast.astro';
import Ornament from '../../components/ui/Ornament.astro';
import ServiceCard from '../../components/ui/ServiceCard.astro';
import SpotIllustration from '../../components/ui/SpotIllustration.astro';
import { TEXT_LINK, TEXT_LINK_ON_VIOLET } from '../../components/ui/link';
import lavenderFields from '../../assets/brand/lavender_fields.png';
import Logo from '../../components/site/Logo.astro';
import { ArrowUp } from '@lucide/astro';
import { BAND_H, LOGO_SIZE, STRIPE_H } from '../../components/site/header';
import HydrationProbe from '../../components/islands/HydrationProbe';

if (!import.meta.env.DEV) return Astro.rewrite('/404');

const spans = [
  ['col-span-12', '12 de 12'],
  ['col-span-12 md:col-span-8', '8 de 12 desde md'],
  ['col-span-12 md:col-span-4', '4 de 12 desde md'],
  ['col-span-12 md:col-span-6', '6 de 12 desde md'],
  ['col-span-12 md:col-span-3', '3 de 12 desde md'],
  ['col-span-12 md:col-span-3 md:col-start-10', '3 de 12, empezando en la 10'],
];

// Single columns, so a column, a gap and the page margin can be compared by eye.
const units = Array.from({ length: 12 }, (_, index) => index + 1);

/* Guide §03: the seven base values (black is reference only) and the
   functional derivatives. The label says the token, the use says where. */
const palette = [
  ['bg-violet text-cream', 'Violeta', 'acción, enlaces, marca, pie'],
  ['bg-wisteria text-ink', 'Glicina', 'fin del degradado, «hu»'],
  ['bg-lavender text-ink', 'Lavanda', 'sección 1'],
  ['bg-stone text-ink', 'Piedra', 'botón secundario'],
  ['bg-cream text-ink border border-border', 'Crema', 'sección 2, tarjetas'],
  ['bg-bone text-ink border border-border', 'Hueso', 'inicio del degradado'],
  ['bg-ink text-cream', 'Ink', 'titulares'],
  ['bg-graphite text-cream', 'Grafito', 'cuerpo'],
  ['bg-slate text-cream', 'Pizarra', 'secundario'],
  ['bg-panel text-ink', 'Panel', 'proceso'],
  ['bg-border text-ink', 'Borde', 'filetes'],
  ['bg-stone-strong text-cream', 'Piedra fuerte', 'borde de campo'],
] as const;

/* The band's three states, as swatches. A live header would be the one in the
   page, which is already showing exactly one of these at a time. */
const bands = [
  ['bg-cream border-b border-border', 'top — en lo alto de la página, opaco, con su filete'],
  ['bg-cream/80 border-b border-border shadow-sm backdrop-blur-[12px]', 'glass — a partir de 40px de scroll'],
  ['bg-cream opacity-40', 'hidden — pasada una pantalla, la barra se retira'],
] as const;
---

<BaseLayout title="Estilo" description="Referencia visual de los primitivos.">
  <Section padding="sm">
    <Grid>
      <div class="col-span-12">
        <h1 class="text-display">Estilo</h1>
        <p class="mt-4 max-w-none text-lead text-graphite">
          Solo en desarrollo. Guía v2. Pulsa <kbd class="rounded border border-border bg-bone px-1.5 py-0.5 text-xs">g</kbd>
          en cualquier página para ver la rejilla.
        </p>
      </div>
    </Grid>
  </Section>

  <Section padding="sm" surface="lavender">
    <Grid class="gap-y-4">
      <div class="col-span-12">
        <h2 class="text-h2">Rejilla</h2>
        <p class="mt-3 max-w-none text-sm text-graphite">
          Una sola rejilla, de borde a borde de la pantalla, igual en todos los
          tamaños: 12 columnas, un hueco entre cada dos y el mismo hueco a la
          izquierda de la primera y a la derecha de la última. Columna, hueco y
          margen miden lo mismo — la pantalla son 25 unidades iguales. Ningún
          elemento elige su propio ancho.
        </p>
      </div>

      {
        units.map((unit) => (
          <div class="col-span-1 rounded bg-wisteria py-2 text-center text-xs text-ink">
            {unit}
          </div>
        ))
      }

      {
        spans.map(([span, label]) => (
          <div class:list={[span, 'rounded bg-wisteria p-3 text-xs text-ink']}>
            {label}
          </div>
        ))
      }
    </Grid>
  </Section>

  <Section padding="sm">
    <Grid class="gap-y-6">
      <h2 class="col-span-12 text-h2">Color</h2>
      {
        palette.map(([swatch, name, use]) => (
          <div class="col-span-6 md:col-span-3 lg:col-span-2">
            <div class:list={['flex h-20 items-end rounded p-3 text-xs font-semibold', swatch]}>
              {name}
            </div>
            <p class="mt-2 max-w-none text-xs text-slate">{use}</p>
          </div>
        ))
      }
      <div class="col-span-12">
        <div class="h-24 rounded bg-hero"></div>
        <p class="mt-2 max-w-none text-xs text-slate">
          Degradado del hero: Hueso hasta el 30 %, Glicina al final. Texto solo en la mitad clara.
        </p>
      </div>
    </Grid>
  </Section>

  <Section padding="sm" surface="lavender">
    <Grid class="gap-y-8">
      <h2 class="col-span-12 text-h2">Tipografía</h2>
      {/* The base layer gives Lora to real h1–h4 only, so the specimen names
          the family itself where it is not a heading element. */}
      <div class="col-span-12 md:col-span-8">
        <p class="font-heading text-display text-ink">Cuando algo se tuerce en casa</p>
        <p class="font-heading text-h2 text-ink">Encabezado 2 — sección</p>
        <p class="font-heading text-h3 text-ink">Encabezado 3 — tarjeta</p>
        <p class="font-heading text-h4 text-ink">Encabezado 4 — paso, nombre</p>
        <p class="mt-4 text-lead text-graphite">Entradilla — text-lead, Urbanist en Grafito.</p>
        <p class="text-base text-graphite">Cuerpo — text-base, 17→18 px, interlineado 1,7.</p>
        <p class="text-sm">Pequeño — text-sm.</p>
        <p class="text-xs text-slate">Pie de foto — text-xs, el mínimo absoluto.</p>
        <p class="text-sm text-slate italic">Microtexto — Todo online · Tus peludos no se mueven de casa</p>
        <p class="font-body text-price text-ink tabular-nums">60 €</p>
      </div>
    </Grid>
  </Section>

  <Section padding="sm">
    <Grid class="gap-y-8">
      <h2 class="col-span-12 text-h2">Botones</h2>

      <div class="col-span-12 flex flex-wrap items-start gap-4 md:col-span-6">
        <Button>Reserva tu sesión</Button>
        <Button variant="secondary">Ver detalles</Button>
        <a href="#" class={TEXT_LINK}>¿Cómo funciona?</a>
      </div>

      <div class="col-span-12 flex flex-wrap items-start gap-4 md:col-span-6">
        <Button disabled>Reserva tu sesión</Button>
        <Button disabled disabledReason="Elige antes una franja">
          Reserva tu sesión
        </Button>
        <Button href="/drops" variant="secondary">Como enlace</Button>
      </div>
    </Grid>
  </Section>

  <Section padding="sm" surface="violet">
    <Grid class="gap-y-8">
      <div class="col-span-12 flex flex-wrap items-center gap-6">
        <Button variant="on-violet">Reserva tu sesión</Button>
        <a href="#" class={TEXT_LINK_ON_VIOLET}>Conoce la historia</a>
        <Logo variant="dark" size={29} />
        <p class="max-w-none text-xs text-lavender">Sobre Violeta: Crema y Lavanda.</p>
      </div>
    </Grid>
  </Section>

  <Section padding="sm" surface="lavender">
    <Grid class="gap-y-8">
      <h2 class="col-span-12 text-h2">Tarjetas y chips</h2>

      <Card class="col-span-12 md:col-span-4">
        <h3 class="text-h4">Tarjeta en reposo</h3>
        <p class="mt-2 max-w-none text-sm text-graphite">
          Crema, borde de 1px, radio de 8px, sombra pequeña.
        </p>
        <p class="mt-3 max-w-none text-xs text-slate">Meta en Pizarra</p>
      </Card>

      <Card interactive class="col-span-12 md:col-span-4">
        <h3 class="text-h4">Tarjeta interactiva</h3>
        <p class="mt-2 max-w-none text-sm text-graphite">
          Pasa a la sombra mediana al pasar por encima.
        </p>
      </Card>

      <Card elevated class="col-span-12 md:col-span-4">
        <h3 class="text-h4">Tarjeta elevada</h3>
        <p class="mt-2 max-w-none text-sm text-graphite">
          Sombra mediana: desplegables y modales.
        </p>
        <div class="mt-4 flex gap-2">
          <Chip>55 €</Chip>
          <Chip tone="status">Agotado</Chip>
        </div>
      </Card>
    </Grid>
  </Section>

  <Section padding="sm">
    <Grid class="gap-y-8">
      <h2 class="col-span-12 text-h2">Tarjeta de sesión</h2>
      <div class="col-span-12 md:col-span-6 lg:col-span-4">
        <ServiceCard
          title="Sesión online individual"
          description="Para ti y tu gato"
          price="55 €"
          features={['Sesión de 60 minutos', 'Online', 'Esencias a medida']}
          preferred
          href="/reservar?servicio=individual"
          actionLabel="Reservar esta sesión"
        />
      </div>
      {/* Spec 05b: the owner's image across the top and a card with no price. */}
      <div class="col-span-12 md:col-span-6 lg:col-span-4">
        <ServiceCard
          title="Seguimiento"
          description="Cuando ya nos conocemos"
          features={['Sesión de 30 minutos']}
          href="/reservar?servicio=seguimiento"
          actionLabel="Reservar esta sesión"
          image={{ src: lavenderFields.src, alt: '' }}
        />
      </div>
      <div class="col-span-12 flex flex-wrap items-center gap-8 lg:col-span-4">
        <SpotIllustration name="flower" />
        <SpotIllustration name="cat" />
        <SpotIllustration name="sprout" />
        <p class="max-w-none text-xs text-slate">
          Hueco de ilustración, 160×160: marcador hasta que lleguen las acuarelas
        </p>
      </div>
    </Grid>
  </Section>

  {/* Spec 05c: the drawings are vectors, so one drawing takes any token.
      Each is shown in two colours to prove it. */}
  <Section padding="sm" surface="lavender">
    <Grid class="gap-y-8">
      <h2 class="col-span-12 text-h2">Flores</h2>
      <div class="col-span-12 flex flex-wrap items-end gap-8 rounded bg-panel p-6 md:col-span-6">
        <Flora process={1} class="w-20" />
        <Flora process={2} class="w-20" />
        <Flora process={3} class="w-20" />
        <Flora process={1} class="w-20 text-graphite" />
        <p class="max-w-none text-xs text-graphite">Siluetas planas: violeta sobre el Panel (y en Grafito)</p>
      </div>
      <div class="col-span-12 flex flex-wrap items-end gap-6 md:col-span-6">
        <Flora line="flower" class="w-28" />
        <Flora line="leaf" class="w-24" />
        <Flora line="daisy" class="w-24 text-violet" />
        <Flora line="sprig" class="w-24 text-stone-strong" />
        <p class="max-w-none text-xs text-slate">Línea fina: Glicina por defecto; cualquier token</p>
      </div>
      <div class="col-span-12 flex flex-wrap items-end gap-8">
        <PressedFlower name="lilac" class="w-32" />
        <PressedFlower name="yellow" class="w-32" />
        <p class="max-w-none text-xs text-slate">Flor prensada: fotografía, color natural, la única excepción a la paleta</p>
      </div>
    </Grid>
  </Section>

  <Section padding="none">
    <div class="h-32 bg-cream"></div>
    <div class="relative h-32 bg-lavender"><SectionEdge class="text-lavender" /></div>
    <div class="relative h-32 bg-cream"><SectionEdge class="text-cream" /></div>
    <div class="relative h-12 bg-violet"><SectionEdge variant="footer" class="text-violet" /></div>
    <Grid class="py-4">
      <p class="col-span-12 max-w-none text-xs text-slate">
        Bordes botánicos: una sola silueta en el color de la sección que empieza, y la del perro y el gato antes del pie.
      </p>
    </Grid>
  </Section>

  <Section padding="sm">
    <Grid class="gap-y-8">
      <h2 class="col-span-12 text-h2">Ornamentos de /drops</h2>
      <div class="col-span-12 flex flex-wrap items-center gap-8 md:col-span-6">
        <Ornament name="small-corner" class="w-10" />
        <Ornament name="small-corner" flip="x" class="w-10" />
        <p class="max-w-none text-xs text-slate">small-corner: esquinas de tarjeta</p>
      </div>
      <div class="col-span-12 flex flex-wrap items-center gap-8 md:col-span-6">
        <Ornament name="side" class="w-9" />
        <Ornament name="side" flip="x" class="w-9" />
        <p class="max-w-none text-xs text-slate">side: flancos de paginación</p>
      </div>
    </Grid>
  </Section>

  <Section padding="sm" surface="violet">
    <Grid class="gap-y-8">
      <div class="col-span-12 flex flex-wrap items-center gap-8">
        <Ornament name="small-corner" knockout flip="y" class="w-12" />
        <Ornament name="small-corner" knockout flip="both" class="w-12" />
        <Ornament name="small-corner" knockout class="w-12" />
        <Ornament name="small-corner" knockout flip="x" class="w-12" />
        <p class="max-w-none text-xs text-lavender">
          small-corner en Crema: marco del banner y de la imagen de un drop
        </p>
      </div>
    </Grid>
  </Section>

  <Section padding="sm">
    <Grid class="gap-y-8">
      <h2 class="col-span-12 text-h2">Campos</h2>

      <Field
        for="nombre"
        label="Nombre"
        placeholder="Ana"
        required
        autocomplete="given-name"
        class="col-span-12 md:col-span-4"
      />

      <Field
        for="email"
        label="Email"
        type="email"
        autocomplete="email"
        required
        help="Te escribimos solo para la reserva."
        class="col-span-12 md:col-span-4"
      />

      <Field
        for="telefono"
        label="Teléfono"
        type="tel"
        inputmode="tel"
        autocomplete="tel"
        optional
        error="Escribe un número de nueve cifras"
        class="col-span-12 md:col-span-4"
      />

      <Field for="mensaje" label="Mensaje" optional class="col-span-12 md:col-span-8">
        <textarea
          id="mensaje"
          name="mensaje"
          class={fieldControlClass({ textarea: true })}></textarea>
      </Field>
    </Grid>
  </Section>

  <Section padding="sm" surface="lavender">
    <Grid class="gap-y-8">
      <h2 class="col-span-12 text-h2">Cabecera</h2>

      <div class="col-span-12 flex flex-col gap-4">
        <div class:list={[STRIPE_H, 'flex items-center justify-center bg-violet']}>
          <p class="max-w-none font-body text-xs font-medium text-cream">
            Sesiones online para toda España.{' '}
            <a href="/reservar" class="text-cream underline underline-offset-4">
              Reserva tu primera consulta
            </a>
          </p>
        </div>

        {
          bands.map(([surface, label]) => (
            <div>
              <div class:list={[BAND_H, surface, 'flex items-center rounded px-4']}>
                <Logo size={LOGO_SIZE} />
              </div>
              <p class="mt-2 max-w-none text-xs text-graphite">{label}</p>
            </div>
          ))
        }

        <div class="flex items-center gap-4">
          <span
            class="flex h-12 w-12 items-center justify-center rounded-full border border-cream bg-violet text-cream shadow-md"
          >
            <ArrowUp size={20} stroke-width={1.5} />
          </span>
          <p class="max-w-none text-xs text-graphite">
            Volver arriba — aparece abajo a la derecha cuando la barra se retira.
          </p>
        </div>
      </div>
    </Grid>
  </Section>

  <Section padding="sm">
    <Grid class="gap-y-8">
      <h2 class="col-span-12 text-h2">Avisos y testimonios</h2>

      <div class="col-span-12 flex flex-col gap-4 md:col-span-6">
        <Toast><strong>Hemos recibido tu reserva.</strong> Te escribimos en menos de 48 horas.</Toast>
        <Toast state="info">Las sesiones son online, por videollamada.</Toast>
        <Toast state="warning"><strong>Esta franja se llena a menudo.</strong> Reserva pronto.</Toast>
        <Toast state="error">
          <strong>No hemos podido enviar el formulario.</strong> Revisa tu conexión y vuelve a
          intentarlo.
        </Toast>
      </div>

      <Testimonial name="Ana García" cat="Miso" class="col-span-12 md:col-span-6">
        Salimos de la sesión más tranquilas las dos. Nunca pensé que fuera a
        notarse tanto en casa.
      </Testimonial>
    </Grid>
  </Section>

  <Section padding="sm" surface="lavender">
    <Grid class="gap-y-4">
      <div class="col-span-12 md:col-span-7">
        <h2 class="text-h2">Isla de React</h2>
        <p class="mt-3 max-w-none text-sm text-graphite">
          Comprobación de spec 04, no un primitivo del sistema. El servidor
          renderiza la primera línea y el navegador la reemplaza al hidratar,
          así que si el texto cambia y el contador sube, la integración de
          React funciona. Las islas de verdad llegan con la reserva (spec 06)
          y el carrito (spec 11).
        </p>
      </div>

      <div class="col-span-12 md:col-span-5">
        <HydrationProbe client:load />
      </div>
    </Grid>
  </Section>
</BaseLayout>
