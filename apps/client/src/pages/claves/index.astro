---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Section from '../../components/layout/Section.astro';
import Grid from '../../components/layout/Grid.astro';
import PostCard from '../../components/claves/PostCard.astro';
import { getAllPosts } from '../../data/posts';
import { getLikeCounts, rankPosts } from '../../lib/likes';

const posts = await getAllPosts();
const counts = await getLikeCounts();

// Pre-rendered with the counts as they stood at build time, so the first paint
// is already in a sensible order. The browser then refreshes and re-sorts.
const ranked = rankPosts(
  posts.map((post) => ({ ...post, likes: counts[post.id] ?? 0 })),
);
---

<BaseLayout
  title="Claves"
  description="Ideas y prácticas de terapia floral para familias multiespecie."
>
  <Section padding="sm">
    <Grid>
      <h1 class="col-span-12 text-h1">Claves</h1>
    </Grid>
  </Section>

  {
    posts.length === 0 ? (
      <Section padding="sm">
        <Grid>
          <p class="col-span-12 max-w-none text-graphite">
            Todavía no hay entradas publicadas.
          </p>
        </Grid>
      </Section>
    ) : (
      <>
        <Section id="featured" padding="sm">
          <Grid class="gap-y-8">
            <h2 class="col-span-12 text-h2">Los que más gustan</h2>
            <div class="contents" id="featured-grid">
              {ranked.featured.map((post) => (
                <PostCard {...post} featured class="col-span-12 md:col-span-6 lg:col-span-4" />
              ))}
            </div>
          </Grid>
        </Section>

        <Section id="recent" padding="sm" hidden={ranked.rest.length === 0}>
          <Grid class="gap-y-8">
            <h2 class="col-span-12 text-h2">Más recientes</h2>
            <div class="contents" id="recent-grid">
              {ranked.rest.map((post) => (
                <PostCard {...post} class="col-span-12 md:col-span-6" />
              ))}
            </div>
          </Grid>
        </Section>
      </>
    )
  }
</BaseLayout>

<script>
  import { getLikeCounts, rankPosts, likesEnabled } from '../../lib/likes';

  /**
   * Counts are read on every page load rather than pushed live, so the order
   * here can differ from the one baked in at build time. Re-sorting client-side
   * keeps a static page honest without an SSR adapter.
   */
  async function refreshLikes() {
    const featuredGrid = document.getElementById('featured-grid');
    const recentGrid = document.getElementById('recent-grid');
    if (!likesEnabled || !featuredGrid || !recentGrid) return;

    const cards = Array.from(
      document.querySelectorAll<HTMLElement>('[data-post-id]'),
    );
    if (cards.length === 0) return;

    const counts = await getLikeCounts();

    const items = cards.map((node) => {
      const id = node.dataset.postId ?? '';
      const likes = counts[id] ?? 0;

      node.dataset.likes = String(likes);
      const label = node.querySelector('.like-count');
      if (label) label.textContent = String(likes);

      return { node, id, date: node.dataset.date ?? '', likes };
    });

    const { featured, rest } = rankPosts(items);

    // append() moves an existing node rather than copying it, so this is a
    // reorder, not a re-render: images already fetched are not re-requested.
    for (const item of featured) featuredGrid.append(item.node);
    for (const item of rest) recentGrid.append(item.node);

    const recent = document.getElementById('recent');
    if (recent) recent.hidden = rest.length === 0;
  }

  refreshLikes();
</script>
