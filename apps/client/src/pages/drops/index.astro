---
import { Image } from 'astro:assets';
import { ChevronLeft, ChevronRight } from '@lucide/astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Section from '../../components/layout/Section.astro';
import Grid from '../../components/layout/Grid.astro';
import PostCard from '../../components/drops/PostCard.astro';
import FilterChip from '../../components/ui/FilterChip.astro';
import Flora from '../../components/ui/Flora.astro';
import { DROP_TYPE_LABELS } from '@kat-hu/contracts';
import { offeredTypes } from '../../lib/drop-filter';
import { BAND_PT, CHROME_PT } from '../../components/site/header';
import { announcement } from '../../data/announcement';
import { getAllPosts } from '../../data/posts';
import { getDropsPageCopy } from '../../data/drops-page';
import { getLikeCounts, rankPosts } from '../../lib/likes';
import banner from '../../assets/brand/banner_drops.jpg';

const posts = await getAllPosts();
const copy = await getDropsPageCopy();
const counts = await getLikeCounts();

/**
 * Rendered for the widest layout — three featured, the rest dealt across three
 * columns — because that is the one the server can be sure of. How many
 * posts are featured and how many fit on a page both depend on the column
 * count, which only the browser knows, so the script re-ranks, re-deals and
 * paginates on load and whenever the count changes (issue I-006).
 */
const COLUMNS = 3;
const ranked = rankPosts(
  posts.map((post) => ({ ...post, likes: counts[post.id] ?? 0 })),
  COLUMNS,
);

/** Every chip any layout could need; the script shows the ones the block it renders holds. */
const typeChips = offeredTypes(posts);

const deal = <T,>(items: T[]) =>
  Array.from({ length: COLUMNS }, (_, column) =>
    items.filter((_item, index) => index % COLUMNS === column),
  );

/**
 * The gap between two stacked cards is the same as the gap between two
 * columns, so the spacing reads square at any width. That gap is one grid unit
 * — `viewport / 25` by construction (I-001) — which no CSS length inside a
 * flex child can name, so the script publishes it as `--card-gap` on `:root`
 * and refreshes it on resize. The `4vw` fallback is the same number to within
 * a scrollbar, so the page is right without JS too (issue I-004).
 */
const cardGap = 'gap-y-[var(--card-gap,4vw)]';

/**
 * Both blocks are built from the same column containers, and a card carries no
 * placement of its own — that is what lets the script move a card between them
 * when the column count changes (issue I-006).
 */
const columnClass = `col-span-12 flex flex-col ${cardGap} md:col-span-6 lg:col-span-4`;

/**
 * In the second block the middle column is raised so its first card starts
 * level with the top of the heading, which is what makes the section read as a
 * masonry rather than as lists. Row placement rather than a negative margin,
 * so it tracks the fluid `text-h2` size by itself: the heading and that column
 * share row 1, the others sit on row 2 (issue I-003). It holds at two columns
 * as well as three (I-004); at one there is nothing to stagger against.
 */
const columnPlacement = [
  'md:col-start-1 md:row-start-2 lg:col-start-1',
  'md:col-start-7 md:row-start-1 md:row-span-2 lg:col-start-5',
  'lg:col-start-9 lg:row-start-2',
];

/**
 * The hero runs under the fixed chrome, so its own words have to clear it.
 * The height is a fact about the chrome, and `header.ts` is where it is
 * written down — read, never retyped (issue I-007).
 */
const heroTop = announcement.enabled ? CHROME_PT : BAND_PT;

const arrowClass =
  'inline-flex h-11 w-11 shrink-0 items-center justify-center rounded-full text-slate transition-colors duration-fast hover:text-ink disabled:cursor-not-allowed disabled:text-stone disabled:hover:text-stone';
---

<BaseLayout
  title="Drops"
  description="Ideas y prácticas de terapia floral para familias multiespecie."
  overHero
>
  {/* The same treatment as the landing's hero: the image is a direct child of
      the Section, outside the Grid, because a full-bleed band is meant to
      reach the screen edges, and `overHero` above lets the band start at the
      top of the document so it scrolls away under the chrome rather than
      pushing it. Shorter than the landing's 80vh on purpose — the source is
      1584x419, and a viewport-tall crop of a 3.8:1 band is a sliver. */}
  <Section
    padding="none"
    class="relative isolate flex min-h-[clamp(20rem,30vw,28rem)] items-end"
  >
    {/* `sizes` describes the image, not the viewport. The band crops with
        `object-cover`, so below 1066px — where the height is pinned at 20rem —
        the photograph is laid out 1210px wide however narrow the screen is,
        and above it at 3.78 × 30vw. `100vw` would understate that by up to
        3.2× and hand a phone a 750px file to fill 1210px of layout. */}
    {/* Below `md` the band shows only about a third of a 3.8:1 photograph, and
        centring it cuts the pipette — the one element that ties the picture to
        the route. The violet glass and its drop sit at 57-74% across (mass
        centre 62.6%), so anchoring the crop at 65% puts the drop just right of
        centre at every width under `md` and takes the trim off the left. From
        `md` the crop is wide enough to hold it centred. */}
    <Image
      src={banner}
      alt=""
      widths={[750, 1188, 1584]}
      sizes="(max-width: 1066px) 1210px, 114vw"
      loading="eager"
      fetchpriority="high"
      class="absolute inset-0 -z-10 h-full w-full rounded-none object-cover object-[65%_50%] md:object-center"
    />
    {/* The banner's dark tint (Ink, the darkest token, since spec 05c), never a lightened image with dark text. */}
    <div
      class="absolute inset-0 -z-10 bg-linear-to-t from-ink/80 to-ink/20"
    >
    </div>

    {/* Display type is hero-only and once per page (guide §2.4); this is that
        one. No action in the band — the primary action on a reading page is a
        card (HIE-01). The foot keeps the next band's botanical edge clear of the
        words (spec 05d); they stay on column 1. */}
    <Grid class:list={[heroTop, 'pb-[calc(4rem+var(--edge-height))]']}>
      <div class="col-span-12 pt-14 md:pt-12 lg:col-span-8 lg:pt-16">
        <h1 class="text-display text-cream">{copy.banner.title}</h1>
        <p class="mt-4 text-lead text-cream">
          {copy.banner.subtitle}
        </p>
      </div>
    </Grid>
  </Section>

  {
    posts.length === 0 ? (
      <Section padding="sm">
        <Grid>
          <p class="col-span-12 max-w-none text-graphite">
            Todavía no hay entradas publicadas.
          </p>
        </Grid>
      </Section>
    ) : (
      <>
        {/* Crema, with the silhouette over the banner's foot, filled in the band's
            own colour (the edge reads `text-*` from its band, as on the landing).
            The recent block shares this colour, so there is no edge between the
            two. The flowers sit behind the cards, in Piedra at half opacity:
            a daisy at the top right (75% on screen) and a flipped sprig low on the left. */}
        <Section
          id="featured"
          padding="sm"
          edge
          surface="cream"
          class="isolate overflow-x-clip text-ink [&_[data-edge]]:text-cream"
        >
          <Flora line="daisy" class="absolute top-[2%] -right-[3.5vw] -z-10 hidden w-[14vw] text-stone opacity-50 lg:block" />
          <Flora line="sprig" class="absolute top-[61%] -left-[5.2vw] -z-10 hidden w-[21vw] -rotate-5 -scale-x-100 text-stone opacity-50 lg:block" />
          <Grid class={cardGap}>
            <h2 class="col-span-12 text-h2 text-violet">{copy.featured.title}</h2>
            {
              deal(ranked.featured).map((column, index) => (
                <div class={columnClass} data-featured-column={index}>
                  {column.map((post) => (
                    <PostCard {...post} />
                  ))}
                </div>
              ))
            }
          </Grid>
        </Section>

        {/* Paging scrolls this section's top to the top of the screen, so the
            section's own top padding is the clearance under the chrome: it is
            the band's height (`BAND_PT`), read from `header.ts` rather than
            retyped, and there is no scroll margin on top of it — one made the
            featured cards' foot show above the filters (spec 05d, I-007). */}
        {/* No surface of its own: the page is already Crema, and a band that
            painted it again would cover the featured band's sprig where it runs
            on past the join. The band's content still paints over the sprig. */}
        <Section
          id="recent"
          padding="sm"
          class:list={[BAND_PT, 'relative isolate overflow-x-clip text-graphite']}
          hidden={ranked.rest.length === 0}
        >
          {/* Piedra at half opacity, above the page and below the cards, sized and
              placed from the owner's markup of 2026-10-02 (in vw so they scale
              with the grid): a leaf past the top-right edge, and two flowers
              at the foot, the second over the first. */}
          <Flora line="leaf" class="absolute top-[7.4vw] -right-[3.7vw] -z-10 hidden w-[21vw] -rotate-15 text-stone opacity-50 lg:block" />
          <Flora line="flower" class="absolute -bottom-[0.7vw] -left-[7.7vw] -z-10 hidden w-[17.7vw] text-stone opacity-50 lg:block" />
          <Flora line="flower" class="absolute bottom-[6.3vw] left-[4.1vw] -z-10 hidden w-[10.6vw] text-stone opacity-50 lg:block" />
          {/* The type filter heads the whole block, centred, above its title and
              cards (owner, 2026-10-02). Hidden until the script has narrowed it
              to the types the block holds — without JS there is nothing to
              filter with. */}
          <Grid class="mb-10 md:mb-12">
            <div class="col-span-12 flex flex-col items-center gap-4 text-center">
              {
                typeChips.length > 0 && (
                  <div
                    id="recent-filter"
                    role="group"
                    aria-label="Filtrar por tipo"
                    class="hidden flex-wrap justify-center gap-2"
                  >
                    <FilterChip label="Todos" value="all" pressed />
                    {typeChips.map((type) => (
                      <FilterChip label={DROP_TYPE_LABELS[type]} value={type} />
                    ))}
                  </div>
                )
              }
              <span id="recent-filter-status" class="sr-only" aria-live="polite"></span>
              {/* A stale `?tipo=` link can name a type with no drops left to show:
                  say so and offer the way out (PAT-07). */}
              <div id="recent-empty" hidden>
                <p class="max-w-none text-graphite">Todavía no hay drops de este tipo.</p>
                <button
                  type="button"
                  data-filter-reset
                  class="mt-2 inline-flex h-11 items-center text-violet underline underline-offset-4 hover:text-violet-hover"
                >
                  Ver todos
                </button>
              </div>
            </div>
          </Grid>
          {/* The same row gap as the featured section, so both headings sit
              the same distance above their cards — and the same unit as every
              other gap on the page (issue I-005). */}
          <Grid class={cardGap}>
            <div class="col-span-12 md:col-span-6 md:row-start-1 lg:col-span-4">
              <h2 class="text-h2 text-violet">{copy.recent.title}</h2>
            </div>
            {
              deal(ranked.rest).map((column, index) => (
                <div
                  class:list={[columnClass, columnPlacement[index]]}
                  data-recent-column={index}
                >
                  {column.map((post) => (
                    <PostCard {...post} />
                  ))}
                </div>
              ))
            }

            {/* The arrows are fixed, so they are rendered here with their
                icons; the script fills in the numbers and works the disabled
                state. Hidden until it does, so a reader without JS gets every
                card and no controls rather than a nav that cannot move. */}
            <nav
              id="recent-pages"
              class="col-span-12 hidden items-center justify-center gap-2 md:row-start-3"
              aria-label="Paginación"
            >
              <button type="button" class={arrowClass} data-page-step="-1" aria-label="Página anterior">
                <ChevronLeft size={20} stroke-width={1.5} />
              </button>
              <span id="recent-page-numbers" class="flex items-center gap-1"></span>
              <button type="button" class={arrowClass} data-page-step="1" aria-label="Página siguiente">
                <ChevronRight size={20} stroke-width={1.5} />
              </button>
              <span id="recent-page-status" class="sr-only" aria-live="polite"></span>
            </nav>
          </Grid>
        </Section>
      </>
    )
  }
</BaseLayout>

<script>
  import { getLikeCounts, rankPosts, likesEnabled } from '../../lib/likes';
  import { createReveal, type Reveal } from '../../lib/reveal';
  import { DROP_TYPE_LABELS, isDropType, type DropType } from '@kat-hu/contracts';
  import {
    filterByType,
    offeredTypes,
    parseTypeParam,
    type DropFilter,
  } from '../../lib/drop-filter';

  type Item = {
    node: HTMLElement;
    id: string;
    date: string;
    likes: number;
    dropType: DropType;
  };

  const featuredColumns = Array.from(
    document.querySelectorAll<HTMLElement>('[data-featured-column]'),
  );
  const recentColumns = Array.from(
    document.querySelectorAll<HTMLElement>('[data-recent-column]'),
  );
  const nav = document.getElementById('recent-pages');
  const numbers = document.getElementById('recent-page-numbers');
  const status = document.getElementById('recent-page-status');
  const filterBar = document.getElementById('recent-filter');
  const filterStatus = document.getElementById('recent-filter-status');
  const empty = document.getElementById('recent-empty');

  /** Matches the `md:` and `lg:` breakpoints the column classes are written to. */
  const columnCount = () => {
    if (window.matchMedia('(min-width: 1024px)').matches) return 3;
    if (window.matchMedia('(min-width: 768px)').matches) return 2;
    return 1;
  };

  /**
   * Three posts are promoted only when three fit across; otherwise the third
   * drops into the second block and sorts by date with everything else. A page
   * holds two rows of cards, so four when a row is one card wide.
   */
  const featuredCount = (columns: number) => (columns === 3 ? 3 : 2);
  const pageSize = (columns: number) => (columns === 1 ? 4 : 6);

  /**
   * One grid unit, which is what separates two columns: the screen is 25 equal
   * units by construction (I-001). `clientWidth` excludes the scrollbar, which
   * is the same width the grid's percentages resolve against, so the vertical
   * gap between stacked cards matches the horizontal one exactly rather than
   * to within a scrollbar (issue I-004).
   */
  const syncCardGap = () => {
    const root = document.documentElement;
    root.style.setProperty('--card-gap', `${root.clientWidth / 25}px`);
  };

  /** Every card on the page, in date order, read once from the server's markup. */
  const items: Item[] = [...featuredColumns, ...recentColumns]
    .flatMap((column) => Array.from(column.children))
    .filter((node): node is HTMLElement => node instanceof HTMLElement)
    .map((node) => ({
      node,
      id: node.dataset.postId ?? '',
      date: node.dataset.date ?? '',
      likes: Number(node.dataset.likes ?? 0),
      dropType: isDropType(node.dataset.dropType) ? node.dataset.dropType : 'post',
    }));

  /**
   * The reader's type filter (spec 05d), from `?tipo=` on load and mirrored
   * back with `replaceState`, so a filtered list can be shared without a
   * history entry per click. It narrows only the recent block: the featured
   * drops are chosen from every drop first.
   */
  let filter: DropFilter = parseTypeParam(new URLSearchParams(location.search).get('tipo'));
  /** Set by the reader's own click, so the first paint stays silent. */
  let announce = false;

  const setFilter = (next: DropFilter) => {
    filter = next;
    announce = true;
    const url = new URL(location.href);
    if (next === 'all') url.searchParams.delete('tipo');
    else url.searchParams.set('tipo', next);
    history.replaceState(null, '', url);
    page = 1;
    paint({ settle: true });
  };

  /** Created after the first paint; null under reduced motion (spec 03c). */
  let reveal: Reveal | null = null;

  let page = 1;
  /** Which way the reader is moving; decides which side the ellipsis sits on. */
  let direction = 1;

  /** At most three numbers between the arrows. */
  const WINDOW = 3;

  /**
   * Deal the cards across the visible columns so the reading order runs
   * left-to-right: with three columns, 1 2 3 on the first row and 4 5 6 under
   * them. Unused columns are hidden; the ones left over widen on their own,
   * because their span classes already say what to do at each breakpoint.
   */
  function fill(
    columns: HTMLElement[],
    count: number,
    cards: Item[],
    settle = false,
  ) {
    columns.forEach((column, index) => {
      column.hidden = index >= count;
      column.replaceChildren();
    });
    cards.forEach((card, index) => {
      columns[index % count]?.append(card.node);
      // A page change puts cards on screen without a scroll, so they are shown
      // outright rather than revealed. Every other re-deal leaves a card as it
      // was: still waiting for its own scroll, or already arrived (spec 03c).
      if (settle) reveal?.settle(card.node);
    });
  }

  /**
   * Shows the chips for the types the block holds, marks the pressed one, and
   * — only after the reader's own click — says what is now listed. The bar is
   * hidden when there is nothing to choose between.
   */
  function paintFilter(everyRest: Item[], shown: Item[]) {
    if (!filterBar) return;

    const offered = offeredTypes(everyRest);
    filterBar.classList.toggle('hidden', offered.length === 0);
    filterBar.classList.toggle('flex', offered.length > 0);

    for (const chip of filterBar.querySelectorAll<HTMLButtonElement>('[data-filter]')) {
      const value = chip.dataset.filter ?? 'all';
      chip.hidden = value !== 'all' && !offered.some((type) => type === value);
      chip.setAttribute('aria-pressed', String(value === filter));
    }

    if (announce && filterStatus) {
      filterStatus.textContent =
        filter === 'all'
          ? `Mostrando todos los drops`
          : `${shown.length} ${shown.length === 1 ? 'drop' : 'drops'} de tipo ${DROP_TYPE_LABELS[filter]}`;
    }
  }

  function paint({ settle = false } = {}) {
    const columns = columnCount();
    const { featured, rest: everyRest } = rankPosts(items, featuredCount(columns));
    const rest = filterByType(everyRest, filter);

    paintFilter(everyRest, rest);

    const size = pageSize(columns);
    const pages = Math.max(1, Math.ceil(rest.length / size));
    page = Math.min(Math.max(page, 1), pages);

    fill(featuredColumns, columns, featured);
    fill(recentColumns, columns, rest.slice((page - 1) * size, page * size), settle);

    // The block is hidden only when there is nothing to filter at all; a
    // filter that matches nothing keeps it, with its way back.
    const recent = document.getElementById('recent');
    if (recent) recent.hidden = everyRest.length === 0;
    if (empty) empty.hidden = !(everyRest.length > 0 && rest.length === 0);

    if (!nav || !numbers || !status) return;

    // `hidden` and `flex` are both display utilities, so exactly one of them
    // is on the element at a time rather than leaving it to source order.
    nav.classList.toggle('hidden', pages < 2);
    nav.classList.toggle('flex', pages > 1);

    if (pages < 2) {
      numbers.replaceChildren();
      return;
    }

    /**
     * The window of three slides with the reader: going forward it ends on the
     * current page, so what is hidden lies behind it; going back it starts on
     * the current page, so what is hidden lies ahead.
     */
    const last = Math.max(1, pages - WINDOW + 1);
    const start =
      pages <= WINDOW
        ? 1
        : Math.max(1, Math.min(direction >= 0 ? page - WINDOW + 1 : page, last));
    const shown = Array.from(
      { length: Math.min(WINDOW, pages) },
      (_, index) => start + index,
    );

    const dots = () => {
      const span = document.createElement('span');
      span.textContent = '…';
      span.setAttribute('aria-hidden', 'true');
      span.className =
        'inline-flex h-11 w-6 shrink-0 items-center justify-center font-body text-xs text-slate';
      return span;
    };

    const number = (value: number) => {
      const button = document.createElement('button');
      button.type = 'button';
      button.dataset.page = String(value);
      button.textContent = String(value);
      // The circle and the weight carry the current page as well as the
      // colour, so it is never signalled by colour alone (guide §9).
      button.className =
        'inline-flex h-11 w-11 shrink-0 items-center justify-center rounded-full font-body text-xs tabular-nums transition-colors duration-fast ' +
        (value === page
          ? 'border border-border bg-cream font-semibold text-ink'
          : 'text-slate hover:bg-lavender hover:text-ink active:bg-border');
      if (value === page) button.setAttribute('aria-current', 'page');
      button.setAttribute('aria-label', `Página ${value}`);
      return button;
    };

    // One ellipsis, on the side the reader came from — unless only one side
    // has anything hidden, in which case that side wins.
    const hiddenBefore = shown[0] > 1;
    const hiddenAfter = shown[shown.length - 1] < pages;
    const side =
      direction >= 0
        ? (hiddenBefore && 'left') || (hiddenAfter && 'right') || null
        : (hiddenAfter && 'right') || (hiddenBefore && 'left') || null;

    numbers.replaceChildren(
      ...(side === 'left' ? [dots()] : []),
      ...shown.map(number),
      ...(side === 'right' ? [dots()] : []),
    );

    for (const arrow of nav.querySelectorAll<HTMLButtonElement>('[data-page-step]')) {
      const step = Number(arrow.dataset.pageStep);
      arrow.disabled = step < 0 ? page === 1 : page === pages;
    }

    status.textContent = `Página ${page} de ${pages}`;
  }

  filterBar?.addEventListener('click', (event) => {
    const chip = (event.target as HTMLElement | null)?.closest<HTMLElement>('[data-filter]');
    if (chip) setFilter(parseTypeParam(chip.dataset.filter));
  });
  empty?.querySelector('[data-filter-reset]')?.addEventListener('click', () => setFilter('all'));

  nav?.addEventListener('click', (event) => {
    const target = (event.target as HTMLElement | null)?.closest('button');
    if (!target) return;

    if (target.dataset.page) {
      const next = Number(target.dataset.page);
      direction = next >= page ? 1 : -1;
      page = next;
    } else if (target.dataset.pageStep) {
      direction = Number(target.dataset.pageStep);
      page += direction;
    } else return;

    paint({ settle: true });
    // Keep the section's top in view: a later page is otherwise entered
    // half-way down, where the cards used to be.
    document.getElementById('recent')?.scrollIntoView({ block: 'start' });
  });

  let current = columnCount();
  window.addEventListener(
    'resize',
    () => {
      // The gap tracks every pixel of width; the cards only need re-dealing
      // when the column count actually changes.
      syncCardGap();

      const next = columnCount();
      if (next === current) return;
      current = next;
      paint();
    },
    { passive: true },
  );

  /**
   * Counts are read on every page load rather than pushed live, so the ranking
   * here can differ from the one baked in at build time. Re-reading them keeps
   * a static page honest without an SSR adapter.
   */
  async function refreshLikes() {
    if (!likesEnabled) return;

    const counts = await getLikeCounts();

    for (const item of items) {
      item.likes = counts[item.id] ?? 0;
      item.node.dataset.likes = String(item.likes);
      const label = item.node.querySelector('.like-count');
      if (label) label.textContent = String(item.likes);
    }

    paint();
  }

  /**
   * Wired once, over the cards this viewport actually placed. Everything that
   * arrives later is handled by `paint`'s `settle` flag, so a reveal can never
   * replay and a re-render can never animate — including the repaint that
   * follows the like counts, which is the easiest one to break (spec 03c).
   */
  function startReveal() {
    reveal = createReveal();

    const dealt = (columns: HTMLElement[]) =>
      columns.flatMap((column) => Array.from(column.children));
    const heading = (section: string) =>
      document.querySelector(`#${section} h2`);
    const present = (node: Element | null): node is Element => node !== null;

    // The featured block is above the fold and already carries the ranking: it
    // arrives, it does not travel.
    reveal.fade([heading('featured'), ...dealt(featuredColumns)].filter(present));
    reveal.observe([heading('recent'), ...dealt(recentColumns)].filter(present));
  }

  // Lay the page out for this viewport before the counts come back, so it is
  // not sitting in the server's three-column shape while it waits.
  syncCardGap();
  if (items.length > 0) {
    paint();
    startReveal();
  }
  refreshLikes();
</script>
