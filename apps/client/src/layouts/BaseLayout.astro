---
interface Props {
  title: string;
  description?: string;
  lang?: string;
}

const { title, description, lang = 'en' } = Astro.props;
---

<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
  :root {
    /* Light only. `light` (not `light dark`) also stops the browser from
       auto-darkening scrollbars and form controls, and opts out of the
       force-dark mode some mobile browsers apply. */
    color-scheme: light;
    --text: #1a1a1a;
    --muted: #5c5c5c;
    --rule: #e6e6e6;
    --bg: #ffffff;
  }

  body {
    margin: 0;
    background: var(--bg);
    color: var(--text);
    font-family: system-ui, -apple-system, 'Segoe UI', sans-serif;
    line-height: 1.6;
  }

  main {
    max-width: 800px;
    margin: 3rem auto;
    padding: 0 1rem;
  }

  a {
    color: inherit;
  }
</style>
