---
/**
 * The advisory stripe (guide §07, *Anuncio*): one full sentence above the
 * header band, optionally carrying one link, Urbanist 500 in Crema on Violeta
 * — 7.27:1 — centred. Never a headline in capitals.
 *
 * It belongs to the top of the page, not to the header: it collapses to zero
 * height the moment the reader scrolls and only comes back at `scrollY === 0`
 * (see `lib/chrome-scroll.ts`). The collapse is a CSS transition on a
 * `data-band` variant, so `prefers-reduced-motion` switches it off for free.
 *
 * Not dismissible: dismissing it would mean remembering the reader, which is
 * a decision the owner has not asked for.
 */
import { STRIPE_H } from './header';
import { announcement } from '../../data/announcement';

const { text, href, linkLabel } = announcement;
---

<div
  class:list={[
    'on-violet flex items-center justify-center overflow-hidden bg-violet text-center',
    'transition-[height,opacity] duration-base ease-soft',
    'group-data-[band=glass]:h-0 group-data-[band=glass]:opacity-0',
    'group-data-[band=hidden]:h-0 group-data-[band=hidden]:opacity-0',
    STRIPE_H,
  ]}
>
  <p class="max-w-none px-5 font-body text-xs font-medium text-cream">
    {text}{' '}
    {
      href && linkLabel && (
        <a
          href={href}
          class="text-cream underline underline-offset-4 transition-colors duration-fast hover:text-lavender"
        >
          {linkLabel}
        </a>
      )
    }
  </p>
</div>
