---
/**
 * Guide §7.9. violet-900 is routine here and almost nowhere else: Cloud text,
 * oak-200 on link hover, 64px top / 40px bottom, the knockout lockup, and the
 * cropped wordmark set behind everything as a watermark.
 *
 * **The surface, the padding and the watermark's placement are the design
 * system's**, not this file's: `.kathu-footer` and `.kathu-footer__watermark`
 * ship in `kathu-tokens.css` with `isolation: isolate`, `overflow: hidden`,
 * `z-index: -1`, violet-800 and `pointer-events: none` already set. Never
 * re-derive them as utilities and never set the violet twice — `Section` is
 * here for the band and nothing else.
 *
 * The watermark is inlined rather than an `<img>` because it takes its colour
 * from CSS, and `aria-hidden` because it is decoration: 1.22:1 on violet-900
 * is meant to register as a change in the surface, never as something to
 * read. Content overlapping it is the intent.
 */
import Section from '../layout/Section.astro';
import Grid from '../layout/Grid.astro';
import Logo from './Logo.astro';
import watermark from '../../assets/brand/kathu-wordmark-half.svg?raw';

/**
 * The design system caps the watermark at `--container-wide` (1320px). The
 * owner wants it to run the full width of the footer on any screen
 * (2026-09-09), so the cap is removed here — `max-w-none` removes a width, it
 * never chooses one, which is why it is the one width utility the grid rule
 * allows (I-001). Everything else about the watermark still comes from
 * `.kathu-footer__watermark`. If this should be the design system's rule
 * rather than this footer's, the change belongs in `references/` first.
 */
const fullWidthWatermark = watermark.replace(
  'class="kathu-footer__watermark"',
  'class="kathu-footer__watermark max-w-none"',
);

/**
 * Where each column sits, at all three arrangements. Every value is a column
 * span or a column start — never a width (I-001).
 *
 * - **Phone**, below `sm`: Navegación and Legal share one row as two
 *   four-column blocks starting at 3 and 7. That is symmetric about the
 *   grid's centre line, so the pair reads as one centred block rather than
 *   two lists pushed to the edges, and it saves roughly 200px of footer that
 *   the 44px link targets had added (owner, 2026-09-09). Contacto keeps its
 *   own row: its one link is the longest label in the footer.
 * - **`sm` (480px) and up**: the three columns share a row, each centred in
 *   its third — `sm:col-start-auto` releases the phone's explicit start.
 * - **`lg` and up**: the desktop arrangement, ranged left, starting at grid
 *   columns 5, 8 and 11 so a one-column gutter opens after the blurb.
 */
const columns = [
  {
    heading: 'Navegación',
    place: 'col-span-4 col-start-3 sm:col-span-4 sm:col-start-auto lg:col-span-2 lg:col-start-5',
    links: [
      { href: '/reservar', label: 'Reservar' },
      { href: '/sobre-kathu', label: 'Sobre kathu' },
      { href: '/drops', label: 'Drops' },
      { href: '/tienda', label: 'Tienda' },
    ],
  },
  {
    heading: 'Legal',
    place: 'col-span-4 col-start-7 sm:col-span-4 sm:col-start-auto lg:col-span-2 lg:col-start-8',
    links: [
      { href: '/aviso-legal', label: 'Aviso legal' },
      { href: '/privacidad', label: 'Privacidad' },
      { href: '/cookies', label: 'Cookies' },
    ],
  },
  {
    heading: 'Contacto',
    place: 'col-span-12 sm:col-span-4 lg:col-span-2 lg:col-start-11',
    links: [{ href: 'mailto:hola@kat-hu.com', label: 'hola@kat-hu.com' }],
  },
];

const year = new Date().getFullYear();
---

<Section as="footer" surface="none" padding="none" class="kathu-footer">
  <Fragment set:html={fullWidthWatermark} />

  <Grid class="gap-y-10">
    {/* Four columns only from lg: at 768 the brand blurb in a quarter of the
        grid wraps to four lines, so it takes its own row first.

        **Everything is centred below `lg`** (owner, 2026-09-09). On a phone
        the columns are stacked and centred; from `sm` the three of them sit
        side by side and each one is centred inside its third, so the block of
        links reads as centred under the centred lockup. At `lg` the footer
        goes back to the desktop arrangement: brand left, columns starting at
        grid columns 5, 8 and 11, everything ranged left. */}
    <div class="col-span-12 text-center lg:col-span-3 lg:text-left">
      {/* 29px: the guide's 24px plus the 20% the owner asked for on
          2026-09-09, the same increase the band's lockup took. */}
      <Logo variant="dark" size={29} />
      <p class="mt-4 max-w-none text-sm text-cloud">
        Terapia floral holística para familias multiespecie.
      </p>
    </div>

    {
      columns.map(({ heading, place, links }) => (
        <nav
          class:list={['text-center lg:text-left', place]}
          aria-labelledby={`footer-${heading.toLowerCase()}`}
        >
          {/* Lora, not Urbanist: the guide forbids the display face below 20px. */}
          <h2
            id={`footer-${heading.toLowerCase()}`}
            class="font-body text-xs font-semibold text-mist"
          >
            {heading}
          </h2>
          {/* The padding belongs on the anchor, never on the `li`: an inline
              anchor's target is its own line box — 25.6px at `text-sm` — and
              padding on the parent is dead space around it. `inline-flex
              min-h-11` is the 44px target from INT-01 and guide §9, and
              `inline-` keeps the link shrink-to-fit so it still centres below
              `lg` and ranges left at `lg`. It costs 10.4px a link, which is
              41.6px of footer from `sm` up and 83.2px on a phone, where all
              three navs stack — accepted by the owner on 2026-09-09. */}
          <ul class="mt-3 list-none p-0">
            {links.map(({ href, label }) => (
              <li>
                <a
                  href={href}
                  class="inline-flex min-h-11 items-center font-body text-sm text-cloud no-underline transition-colors duration-fast hover:text-oak-200 hover:underline"
                >
                  {label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      ))
    }

    {/* §7.9: legal fine print below 14px goes in White rather than Cloud.
        Centred, unlike the columns above: it closes the page rather than
        belonging to any one of them. */}
    <div class="col-span-12 text-center">
      <p class="max-w-none text-xs text-white">
        © {year} kathu. Todos los derechos reservados.
      </p>
      <p class="mt-2 max-w-none text-xs text-white">
        kathu no sustituye la atención veterinaria. Consulta siempre con tu
        veterinaria de referencia.
      </p>
    </div>
  </Grid>
</Section>
