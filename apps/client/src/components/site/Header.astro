---
/**
 * The site chrome: the advisory stripe and the band, in one `fixed` wrapper.
 *
 * **One attribute drives everything.** The script's only job is to write
 * `data-band="top | glass | hidden"` onto the wrapper; every visual
 * difference is a Tailwind `data-*` variant on a CSS transition. That keeps
 * the policy in `lib/chrome-scroll.ts` where it can be tested, and it means
 * the token file's blanket `prefers-reduced-motion` rule switches the whole
 * chrome's motion off for free — which is exactly what it cannot do for a
 * scripted animation.
 *
 * **The band is opaque Shell in every state and the lockup is always the
 * violet one** (owner's decision, 2026-09-08). There is no transparent
 * treatment over a hero and no knockout swap: one logo, one background, so
 * nothing about the header changes with the page behind it.
 *
 * Sizes supersede guide §7.7 — see `header.ts`.
 *
 * The mobile menu stays a `<details>` disclosure, so it opens and its links
 * work with no JavaScript at all. The script only adds what a `<details>`
 * cannot: the scroll lock, Escape, and focus.
 */
import { Menu, X } from '@lucide/astro';
import Section from '../layout/Section.astro';
import Grid from '../layout/Grid.astro';
import Logo from './Logo.astro';
import AnnouncementBar from './AnnouncementBar.astro';
import { BAND_H, LOGO_SIZE, STRIPE_TOP } from './header';
import { announcement } from '../../data/announcement';

const links = [
  { href: '/reservar', label: 'Reservar' },
  { href: '/sobre-kathu', label: 'Sobre kathu' },
  { href: '/drops', label: 'Drops' },
  { href: '/tienda', label: 'Tienda' },
];

const path = Astro.url.pathname;
const isActive = (href: string) => path === href || path.startsWith(`${href}/`);

const link =
  'font-body text-sm font-medium whitespace-nowrap no-underline transition-colors duration-fast';

const active = 'text-ink underline decoration-violet-700 decoration-2 underline-offset-6';

/* The sheet covers the page but never the stripe: opening the menu must not
   move anything that was already on screen. */
const sheetTop = announcement.enabled ? STRIPE_TOP : 'top-0';
---

<div
  id="site-chrome"
  data-band="top"
  class="group fixed inset-x-0 top-0 z-40 transition-transform duration-base ease-out-soft data-[band=hidden]:-translate-y-full"
>
  {announcement.enabled && <AnnouncementBar />}

  {/* Shell at rest; translucent Shell with a blur once the page has moved.
      Never below /70 — Slate links over a photograph stop clearing §9. */}
  <header
    class="bg-shell transition-[background-color,box-shadow] duration-base ease-out-soft group-data-[band=glass]:border-b group-data-[band=glass]:border-mist group-data-[band=glass]:bg-shell/80 group-data-[band=glass]:shadow-sm group-data-[band=glass]:backdrop-blur-[12px]"
  >
    <Section as="div" padding="none">
      <Grid class:list={[BAND_H, 'items-center']}>
        <div class="col-span-6 flex items-center md:col-span-4">
          <Logo id="site-home" href="/" size={LOGO_SIZE} />
        </div>

        {/* Four links need more than half the grid at exactly 768px, where the
            nav first appears — otherwise "Sobre kathu" wraps onto two lines. */}
        <nav
          class="col-span-6 hidden items-center justify-end gap-8 md:col-span-8 md:flex"
          aria-label="Principal"
        >
          {
            links.map(({ href, label }) => (
              <a
                href={href}
                aria-current={isActive(href) ? 'page' : undefined}
                class:list={[link, isActive(href) ? active : 'text-slate hover:text-ink']}
              >
                {label}
              </a>
            ))
          }
        </nav>

        <details id="site-menu" class="col-span-6 justify-self-end md:hidden">
          <summary
            class="flex h-11 w-11 cursor-pointer list-none items-center justify-center rounded-sm text-slate [&::-webkit-details-marker]:hidden"
            aria-label="Abrir el menú"
            aria-expanded="false"
          >
            <Menu size={24} stroke-width={1.5} />
          </summary>

          {/* A sheet, not a band under the bar: the rest of the screen, in
              white — the one surface guide §3.4 sanctions for a sheet. Its
              first row sits exactly where the band's was, so the lockup and
              the control in the corner do not move as it opens. */}
          <div
            id="site-sheet"
            class:list={[
              sheetTop,
              'fixed inset-x-0 bottom-0 z-50 flex flex-col bg-white',
              /* Past the top of the page the stripe is collapsed, so there is
                 nothing to sit below and the sheet takes the whole screen. */
              'group-data-[band=glass]:top-0 group-data-[band=hidden]:top-0',
            ]}
          >
            <Grid class:list={[BAND_H, 'shrink-0 items-center']}>
              <div class="col-span-6 flex items-center">
                <Logo size={LOGO_SIZE} />
              </div>
              <button
                id="site-menu-close"
                type="button"
                class="col-span-6 flex h-11 w-11 cursor-pointer items-center justify-center justify-self-end rounded-sm text-slate transition-colors duration-fast hover:text-ink"
                aria-label="Cerrar el menú"
              >
                <X size={24} stroke-width={1.5} />
              </button>
            </Grid>

            {/* The links are the sheet's only content, so they take the space
                that is left and sit in the middle of it — `content-center`
                centres the grid's rows, the flex column centres each link. */}
            <Grid class="flex-1 content-center">
              <nav class="col-span-12" aria-label="Principal">
                <ul class="m-0 flex list-none flex-col items-center gap-4 p-0">
                  {
                    links.map(({ href, label }) => (
                      <li>
                        <a
                          href={href}
                          data-sheet-link
                          aria-current={isActive(href) ? 'page' : undefined}
                          class:list={[
                            'flex min-h-11 items-center justify-center px-4 text-center font-body text-lead no-underline',
                            isActive(href) ? active : 'text-graphite',
                          ]}
                        >
                          {label}
                        </a>
                      </li>
                    ))
                  }
                </ul>
              </nav>
            </Grid>
          </div>
        </details>
      </Grid>
    </Section>
  </header>
</div>

<script>
  import {
    AT_TOP,
    nextAnchor,
    nextChromeState,
    type ChromeState,
  } from '../../lib/chrome-scroll';

  const chrome = document.getElementById('site-chrome');
  const menu = document.getElementById('site-menu') as HTMLDetailsElement | null;

  /* ---------------------------------------------------------------- band */

  if (chrome) {
    let current: ChromeState = AT_TOP;
    let anchor = 0;
    let queued = false;

    const paint = () => {
      queued = false;

      // The band never moves out from under an open sheet.
      if (menu?.open) return;

      const next = nextChromeState({
        scrollY: window.scrollY,
        viewportHeight: window.innerHeight,
        previous: current,
        lastY: anchor,
      });
      anchor = nextAnchor({ scrollY: window.scrollY, band: next.band, lastY: anchor });

      if (next.band !== current.band) {
        chrome.dataset.band = next.band;
        // The back-to-top button lives outside this wrapper, so it is told
        // rather than styled: one decision, two places to paint it.
        document.dispatchEvent(
          new CustomEvent('chrome:band', { detail: next }),
        );
      }

      current = next;
    };

    const onScroll = () => {
      if (queued) return;
      queued = true;
      requestAnimationFrame(paint);
    };

    paint();
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll, { passive: true });
  }

  /* --------------------------------------------------------------- sheet */

  if (menu) {
    const summary = menu.querySelector('summary');
    const sheet = document.getElementById('site-sheet');
    const close = document.getElementById('site-menu-close');
    const root = document.documentElement;

    /* Everything in the sheet is visible while the sheet is open, so this is
       the whole list — no visibility filtering to get wrong. */
    const focusable = () =>
      Array.from(sheet?.querySelectorAll<HTMLElement>('a[href], button') ?? []);

    /**
     * The entrance is a one-shot, so it is the Web Animations API and it
     * reads its numbers off the tokens rather than repeating them.
     */
    const play = () => {
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

      const styles = getComputedStyle(root);
      const duration = Number.parseFloat(styles.getPropertyValue('--duration-base')) || 200;
      const easing = styles.getPropertyValue('--ease-out-soft').trim() || 'ease-out';

      sheet?.animate([{ opacity: 0 }, { opacity: 1 }], { duration, easing });

      sheet?.querySelectorAll<HTMLElement>('[data-sheet-link]').forEach((item, index) => {
        item.animate(
          [
            { opacity: 0, transform: 'translateY(6px)' },
            { opacity: 1, transform: 'none' },
          ],
          { duration, delay: index * 40, easing, fill: 'backwards' },
        );
      });
    };

    menu.addEventListener('toggle', () => {
      summary?.setAttribute('aria-expanded', String(menu.open));
      root.classList.toggle('overflow-hidden', menu.open);

      if (menu.open) {
        play();
        close?.focus();
      } else {
        summary?.focus();
      }
    });

    close?.addEventListener('click', () => menu.removeAttribute('open'));

    sheet?.addEventListener('click', (event) => {
      if ((event.target as HTMLElement).closest('a[href]')) {
        menu.removeAttribute('open');
      }
    });

    document.addEventListener('keydown', (event) => {
      if (!menu.open) return;

      if (event.key === 'Escape') {
        event.preventDefault();
        menu.removeAttribute('open');
        return;
      }

      if (event.key !== 'Tab') return;

      // Trap: the sheet covers the page, so nothing behind it may be reached.
      const items = focusable();
      if (items.length === 0) return;

      const first = items[0];
      const last = items[items.length - 1];
      const active = document.activeElement;

      if (event.shiftKey && (active === first || !sheet?.contains(active))) {
        event.preventDefault();
        last.focus();
      } else if (!event.shiftKey && active === last) {
        event.preventDefault();
        first.focus();
      }
    });
  }
</script>
