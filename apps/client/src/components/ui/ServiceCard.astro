---
/**
 * Guide §7.4, the service / reserva card (spec 05): left-aligned, spot
 * illustration, `text-h3` title, two lines, duration • modality in Slate with
 * a Mist dot, the price in `text-h4` violet-700 with the euro sign after it.
 *
 * The sessions are the owner's own (spec 05b), so every line under the title
 * is optional. A line the owner left empty is left out — never filled with
 * default text — and what remains keeps its order (CON-03). The slot is always
 * 160×160: the owner's watercolour shown whole (`object-contain`, never
 * cropped, and `rounded-none` against the base layer's 8px image radius, so its
 * soft edges survive), or the Lucide stand-in until there is one.
 *
 * The button is **outlined**, not the guide's primary: the landing has exactly
 * one filled violet-700 action, the hero's (HIE-01). Full width on a phone,
 * its own width from `md`. The price and the button sit at the bottom, so
 * cards in one row line up however long their descriptions are — with or
 * without a price.
 */
import type { ComponentProps } from 'astro/types';
import Button from './Button.astro';
import Card from './Card.astro';
import SpotIllustration from './SpotIllustration.astro';

interface Props {
  title: string;
  description?: string;
  duration?: string;
  modality?: string;
  price?: string;
  href: string;
  actionLabel: string;
  /** The owner's image, already sized for the slot; `alt` is `""` when it is decoration. */
  image?: { src: string; alt: string };
  /** The stand-in drawn while there is no `image`. */
  illustration: ComponentProps<typeof SpotIllustration>['name'];
  class?: string;
}

const {
  title,
  description,
  duration,
  modality,
  price,
  href,
  actionLabel,
  image,
  illustration,
  class: className,
} = Astro.props;

/** The slot's side in px, guide §7.4. */
const SLOT = 160;
---

<Card class:list={['flex h-full flex-col', className]}>
  {
    image ? (
      <img
        src={image.src}
        alt={image.alt}
        width={SLOT}
        height={SLOT}
        loading="lazy"
        decoding="async"
        class="size-40 shrink-0 rounded-none object-contain"
      />
    ) : (
      <SpotIllustration name={illustration} />
    )
  }
  <h3 class="mt-6 text-h3 text-ink">{title}</h3>
  {description && <p class="mt-2 max-w-none text-sm text-graphite">{description}</p>}
  {
    (duration || modality) && (
      <p class="mt-4 max-w-none text-xs text-slate">
        {duration}
        {duration && modality && <span class="text-mist"> • </span>}
        {modality}
      </p>
    )
  }
  <div class="mt-auto flex flex-col pt-4">
    {price && <p class="max-w-none text-h4 text-violet-700">{price}</p>}
    <Button
      href={href}
      variant="secondary"
      class={price ? 'mt-6 w-full md:w-auto md:self-start' : 'w-full md:w-auto md:self-start'}
    >
      {actionLabel}
    </Button>
  </div>
</Card>
