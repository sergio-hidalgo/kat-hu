---
/**
 * Guide §07, *Tarjeta de servicio* (spec 05, 05b, 05c; redone 2026-10-02 as the
 * owner's mix of the mock-up and the Figma): the session's picture across the
 * top, the `h3` title, a Pizarra subtitle, the price large in Urbanist, a list
 * of up to three things the session includes, each with a check, and a
 * full-width button at the bottom.
 *
 * The sessions are the owner's own (spec 05b), so every line is optional. A
 * line the owner left empty is left out — never filled with default text — and
 * what remains keeps its order (CON-03). The picture slot is always one shape
 * (13:6): the owner's image cropped to it, or a Piedra block until there is
 * one, so the cards of a row start level.
 *
 * **The preferred session** is the owner's pick: a *Preferido* badge centred on
 * the card's top border and the page's one filled Violeta button (a deliberate
 * exception to HIE-01, asked for by the owner); every other card keeps the
 * secondary Piedra. The button sits at the bottom, so the buttons of a row
 * line up however long the cards above are.
 */
import Button from './Button.astro';
import Card from './Card.astro';
import { Check } from '@lucide/astro';

interface Props {
  title: string;
  description?: string;
  price?: string;
  /** What the session includes, one line each; the caller keeps it to three. */
  features?: string[];
  href: string;
  actionLabel: string;
  preferred?: boolean;
  /** The owner's image, already cropped to the slot; `alt` is `""` when it is decoration. */
  image?: { src: string; alt: string; srcset?: string; sizes?: string };
  class?: string;
}

const {
  title,
  description,
  price,
  features = [],
  href,
  actionLabel,
  preferred = false,
  image,
  class: className,
} = Astro.props;

/** The slot's shape, shared by the image and its stand-in. */
const SLOT = 'aspect-[13/6] w-full';
---

<Card class:list={['relative flex h-full flex-col', className]} data-preferred={preferred ? '' : undefined}>
  {
    preferred && (
      <span
        data-badge
        class="absolute top-0 left-1/2 -translate-x-1/2 -translate-y-1/2 rounded-full bg-violet px-4 py-1 text-xs font-medium whitespace-nowrap text-cream"
      >
        Preferido
      </span>
    )
  }
  {
    image ? (
      <img
        src={image.src}
        srcset={image.srcset}
        sizes={image.sizes}
        alt={image.alt}
        width={520}
        height={240}
        loading="lazy"
        decoding="async"
        class:list={[SLOT, 'shrink-0 object-cover']}
      />
    ) : (
      <div data-placeholder aria-hidden="true" class:list={[SLOT, 'shrink-0 rounded bg-stone']}></div>
    )
  }
  <h3 class="mt-4 text-h3 text-ink">{title}</h3>
  {description && <p class="mt-1 max-w-none text-sm text-slate">{description}</p>}
  {
    price && (
      <p data-price class="mt-3 max-w-none font-body text-price text-ink tabular-nums">
        {price}
      </p>
    )
  }
  {
    features.length > 0 && (
      <ul class="mt-3 flex list-none flex-col gap-2 p-0" aria-label="Incluye">
        {features.map((line) => (
          <li class="flex items-center gap-2 text-sm text-graphite">
            <Check size={20} stroke-width={1.75} class="shrink-0 text-violet" aria-hidden="true" />
            {line}
          </li>
        ))}
      </ul>
    )
  }
  <div class="mt-auto flex flex-col pt-5">
    <Button href={href} variant={preferred ? 'primary' : 'secondary'} class="w-full">
      {actionLabel}
    </Button>
  </div>
</Card>
