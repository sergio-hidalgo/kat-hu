---
/**
 * One of the owner's flower drawings, coloured from CSS (see `flora.ts`).
 *
 * Paints a línea-fina study through its cached file as a mask. The caller
 * gives a **width** (`w-24`) and any placement; the height follows the drawing. A `text-*` class replaces the
 * default tone — the drawings take any token, which is why they are vectors.
 */
import { LINE_LAYER, LINE_STUDIES, LINE_TONE, aspectRatio, type LineStudy } from './flora';

interface Props {
  line: LineStudy;
  class?: string;
}

const props = Astro.props;

const hasTone = /\btext-/.test(props.class ?? '');

const study = LINE_STUDIES[props.line];
// The mask is a custom property, not yet a `mask`: a `url()` is only fetched
// when a property uses it, and `lib/flora-boot.ts` switches `data-mask-on` on
// after the page has loaded and the drawing is near the screen.
const lineStyle = `--flora-mask: url("${study.url}") ${LINE_LAYER}; aspect-ratio: ${aspectRatio(study.viewBox)};`;
---

<div
  aria-hidden="true"
  data-flora={`line-${props.line}`}
  data-mask-defer
  class:list={['pointer-events-none bg-current select-none', !hasTone && LINE_TONE, props.class]}
  style={lineStyle}
>
</div>
