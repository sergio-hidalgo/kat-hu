---
/**
 * Guide §07, the one card recipe: Crema, a 1px border, 8px radius, the small
 * violet-tinted shadow at rest and the medium one on hover, 24px padding. The
 * border and shadow are what keep a Crema card visible on a Crema band.
 *
 * A card lays out its own contents. It never nests a `<Grid>`: the 12-column
 * grid places the card, and stops there.
 */
import type { HTMLTag } from 'astro/types';

interface Props {
  /* Quoted — see the note in Section.astro. */
  'as'?: HTMLTag;
  /** Cards that are links lift to the medium shadow on hover. */
  interactive?: boolean;
  /** Floating surfaces — dropdowns, modals — sit on the medium shadow. */
  elevated?: boolean;
  padded?: boolean;
  class?: string;
  [key: string]: unknown;
}

const {
  as: Tag = 'article',
  interactive = false,
  elevated = false,
  padded = true,
  class: className,
  ...rest
} = Astro.props;
---

<Tag
  class:list={[
    'rounded border border-border bg-cream',
    elevated ? 'shadow-md' : 'shadow-sm',
    padded && 'p-6',
    interactive && 'transition-shadow duration-base hover:shadow-md',
    className,
  ]}
  {...rest}
>
  <slot />
</Tag>
