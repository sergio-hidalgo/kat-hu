---
/**
 * A pill (guide §05: round corners are for pills and avatars). Two tones:
 * `price` in Lavanda with Ink (11.6:1), and `status` — *Agotado* and friends —
 * on Hueso with a border and Pizarra (6.4:1). Neither is ever the only way a
 * state is told: the words say it.
 */
type Tone = 'price' | 'status';

interface Props {
  tone?: Tone;
  class?: string;
}

const { tone = 'price', class: className } = Astro.props;

const tones: Record<Tone, string> = {
  price: 'bg-lavender text-ink font-semibold',
  status: 'border border-border bg-bone text-slate',
};
---

<span
  class:list={[
    'inline-flex items-center rounded-full px-3 py-0.5 font-body text-sm',
    tones[tone],
    className,
  ]}
>
  <slot />
</span>
