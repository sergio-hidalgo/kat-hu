---
/**
 * Four white corners framing a photograph (specs 04c, 05): the `/drops` banner,
 * through `BannerFrame`, the landing hero, and a drop's main image. Each is a
 * mirror of the one `small-corner` drawing — native bottom-left — so its base
 * sits against the two edges it decorates.
 *
 * White, not the cards' violet: over a photograph these are knockout marks
 * (guide §3.4, `KNOCKOUT_TONE`).
 *
 * The box is absolutely positioned at the left, right and bottom of its
 * positioned parent; the caller says where its top is — `top-0` over an image,
 * the chrome's height over the banner. The
 * sizes step with the breakpoints so the corners' side arms, about a third of
 * the box, stay inside the 1-unit edge margin from `md` up on the banner
 * (I-001); every frame uses the same steps, so they read as one family.
 */
import Ornament from './Ornament.astro';

interface Props {
  /** Where the box starts: a `top-*` class. */
  top: string;
  [key: string]: unknown;
}

const { top, ...rest } = Astro.props;

const corner = 'absolute w-9 lg:w-10 xl:w-12 2xl:w-14';

const CORNERS = [
  { at: 'top-left', flip: 'y', place: 'top-0 left-0' },
  { at: 'top-right', flip: 'both', place: 'top-0 right-0' },
  { at: 'bottom-left', flip: undefined, place: 'bottom-0 left-0' },
  { at: 'bottom-right', flip: 'x', place: 'right-0 bottom-0' },
] as const;
---

<div
  aria-hidden="true"
  class:list={['pointer-events-none absolute inset-x-0 bottom-0 p-2 lg:p-3', top]}
  {...rest}
>
  <div class="relative h-full">
    {
      CORNERS.map(({ flip, place }) => (
        <Ornament name="small-corner" knockout flip={flip} class={`${corner} ${place}`} />
      ))
    }
  </div>
</div>
