---
/**
 * Guide §07, *Botones*. Renders an `<a>` when given `href`, a `<button>`
 * otherwise. 48px high, 8px radius, Urbanist 500 16px, label on one line.
 *
 * - `primary` — Violeta, Crema label. The one action a view recommends; the
 *   landing carries exactly one (HIE-01).
 * - `secondary` — Piedra with an Ink label (7.8:1). Alternatives at the same
 *   level that are not the recommended one.
 * - `on-violet` — Crema with a Violeta label, for a primary inside the footer
 *   or the announcement.
 * - disabled — no fill, a dashed Piedra-fuerte border and a Pizarra label, so
 *   it can never be mistaken for the filled secondary; with `disabledReason`
 *   it says what is missing.
 *
 * The guide's fourth kind, *Enlace*, is a text link: `TEXT_LINK` in `link.ts`.
 *
 * `class` is for placement only — a column span, a margin, `w-full`. Recolouring
 * a button inline is a defect; add a variant here instead.
 */
type Variant = 'primary' | 'secondary' | 'on-violet';

interface Props {
  variant?: Variant;
  href?: string;
  type?: 'button' | 'submit' | 'reset';
  disabled?: boolean;
  /** One Pizarra line under the button saying why it is unavailable. */
  disabledReason?: string;
  class?: string;
  [key: string]: unknown;
}

const {
  variant = 'primary',
  href,
  type = 'button',
  disabled = false,
  disabledReason,
  class: className,
  ...rest
} = Astro.props;

const base =
  'inline-flex h-12 items-center justify-center rounded px-6 font-body text-sm font-medium whitespace-nowrap no-underline transition-colors duration-fast';

// Hover darkens and active darkens further, so a held button reads as pushed in.
const variants: Record<Variant, string> = {
  primary: 'bg-violet text-cream hover:bg-violet-hover hover:text-cream active:bg-violet-active',
  secondary: 'bg-stone text-ink hover:bg-stone-hover hover:text-ink active:bg-stone-strong',
  'on-violet': 'bg-cream text-violet hover:bg-lavender hover:text-violet',
};

const off = 'border border-dashed border-stone-strong bg-transparent text-slate cursor-not-allowed';

const Tag = href && !disabled ? 'a' : 'button';

// With a reason, the caller's placement classes go on the wrapper instead, so
// the button and its explanation move as one.
const wrapped = Boolean(disabledReason);

const attrs = {
  'class:list': [base, disabled ? off : variants[variant], !wrapped && className],
  href: Tag === 'a' ? href : undefined,
  type: Tag === 'button' ? type : undefined,
  disabled: Tag === 'button' && disabled ? true : undefined,
  'aria-disabled': disabled ? ('true' as const) : undefined,
  ...rest,
};
---

{
  wrapped ? (
    <span class:list={['flex flex-col items-start gap-2', className]}>
      <Tag {...attrs}>
        <slot />
      </Tag>
      <span class="text-xs text-slate">{disabledReason}</span>
    </span>
  ) : (
    <Tag {...attrs}>
      <slot />
    </Tag>
  )
}
