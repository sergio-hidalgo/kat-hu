---
/**
 * Guide §7.8. No card, no quotation-mark graphic: a 2px oak rule on the left,
 * the quote in italic Lora, and the attribution below — the person's name and
 * the cat's, which is the detail that makes this practice recognisable.
 */
interface Props {
  name: string;
  /** The cat's name. Rendered after the person's, separated by a Mist dot. */
  cat?: string;
  class?: string;
}

const { name, cat, class: className } = Astro.props;
---

<figure class:list={['border-l-2 border-oak-400 pl-5', className]}>
  <blockquote class="text-lead font-body text-graphite italic">
    <slot />
  </blockquote>
  <figcaption class="mt-3 text-xs text-slate not-italic">
    {name}{cat && <span class="text-mist"> • </span>}{cat}
  </figcaption>
</figure>
