---
/**
 * Guide §07, *Testimonios*: the same card as the services. The quote between
 * Latin quotation marks in Urbanist, Ink; the signature under it — a 44px
 * avatar with the person's initials (Lavanda, Violeta letters), the name in
 * Lora 600, and *Familia de …* with the cat's name in Pizarra, which is the
 * detail that makes this practice recognisable.
 *
 * Only real testimonials with permission are published (the Studio's rule),
 * so there are no stock faces here: initials, never a generic avatar.
 */
import Card from './Card.astro';
import { initials } from './initials';

interface Props {
  name: string;
  /** The cat's name — *Familia de {cat}*. */
  cat?: string;
  class?: string;
}

const { name, cat, class: className } = Astro.props;
---

<Card as="figure" class:list={['flex h-full flex-col', className]}>
  <blockquote class="text-base text-ink">
    <p class="max-w-none">«<slot />»</p>
  </blockquote>
  <figcaption class="mt-auto flex items-center gap-3 pt-6">
    <span
      aria-hidden="true"
      class="flex size-11 shrink-0 items-center justify-center rounded-full bg-stone font-body text-sm font-semibold text-ink"
    >
      {initials(name)}
    </span>
    <span class="flex flex-col">
      <span class="font-heading text-base font-semibold text-ink">{name}</span>
      {cat && <span class="text-xs text-slate">Familia de {cat}</span>}
    </span>
  </figcaption>
</Card>
