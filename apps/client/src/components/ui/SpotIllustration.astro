---
/**
 * The 160×160 slot for a service's picture (spec 05, 05b): the owner uploads a
 * small watercolour per session in the Studio. Until there is one, the slot
 * holds a quiet Lucide stand-in on a Lavanda disc — deliberate enough that the
 * card reads as finished, never as a missing image. Decorative: hidden from
 * assistive tech either way.
 */
import { Cat, Flower2, Sprout } from '@lucide/astro';

interface Props {
  name: 'flower' | 'cat' | 'sprout';
  class?: string;
}

const ICONS = { flower: Flower2, cat: Cat, sprout: Sprout };

const { name, class: className } = Astro.props;
const Icon = ICONS[name];
---

<div
  aria-hidden="true"
  data-spot={name}
  class:list={[
    'flex size-40 shrink-0 items-center justify-center rounded-full bg-lavender text-violet',
    className,
  ]}
>
  <Icon size={48} stroke-width={1.75} />
</div>
