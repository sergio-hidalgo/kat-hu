---
/**
 * Guide §07, *Formularios*. The label always visible above the field (Urbanist
 * 600, Ink) — never a placeholder standing in for it — help below in Pizarra,
 * and an error below with an icon, saying how to fix it.
 *
 * The guide marks the **optional** fields, not the required ones: a form asks
 * only for what it needs, so *(opcional)* is the exception worth reading. It is
 * an explicit `optional`, never inferred from a missing `required` — a slotted
 * control can be required on its own, and a wrong *(opcional)* is worse than
 * none.
 *
 * By default it renders its own `<input>`. Pass a control in the slot instead
 * (a `<textarea>`, a `<select>`) and it will style that one; Astro slots cannot
 * receive props, so the slotted control asks for the classes with
 * `class={fieldControlClass({ error })}`.
 */
import type { HTMLAttributes } from 'astro/types';
import { CircleAlert } from '@lucide/astro';
import { fieldControlClass } from './field';

type InputAttributes = HTMLAttributes<'input'>;

interface Props {
  /** Must match the control's `id`. */
  for: string;
  label: string;
  help?: string;
  /** Say what to fix — *Escribe un email válido*, not *Campo inválido*. */
  error?: string;
  required?: boolean;
  /** Label the field *(opcional)* (guide §07). */
  optional?: boolean;
  /** Ignored when a control is slotted in. */
  type?: InputAttributes['type'];
  name?: string;
  placeholder?: string;
  autocomplete?: InputAttributes['autocomplete'];
  inputmode?: InputAttributes['inputmode'];
  class?: string;
}

const {
  for: htmlFor,
  label,
  help,
  error,
  required = false,
  optional = false,
  type = 'text',
  name,
  placeholder,
  autocomplete,
  inputmode,
  class: className,
} = Astro.props;

const helpId = help && !error ? `${htmlFor}-help` : undefined;
const errorId = error ? `${htmlFor}-error` : undefined;
const describedBy = errorId ?? helpId;
---

<div class:list={['flex flex-col gap-2', className]}>
  <label for={htmlFor} class="font-body text-sm font-semibold text-ink">
    {label}
    {optional && !required && <span class="font-normal text-slate"> (opcional)</span>}
  </label>

  {
    Astro.slots.has('default') ? (
      <slot />
    ) : (
      <input
        id={htmlFor}
        name={name ?? htmlFor}
        type={type}
        placeholder={placeholder}
        autocomplete={autocomplete}
        inputmode={inputmode}
        required={required || undefined}
        aria-invalid={error ? 'true' : undefined}
        aria-describedby={describedBy}
        class={fieldControlClass({ error: Boolean(error) })}
      />
    )
  }

  {
    help && !error && (
      <p id={helpId} class="max-w-none text-xs text-slate">
        {help}
      </p>
    )
  }

  {
    error && (
      <p
        id={errorId}
        class="flex max-w-none items-center gap-1 text-xs text-error"
        aria-live="polite"
      >
        <CircleAlert size={16} stroke-width={1.75} class="shrink-0" aria-hidden="true" />
        {error}
      </p>
    )
  }
</div>
