---
/**
 * `block:testimonials` (spec 05): up to three testimonials from Sanity, as
 * guide §7.8 — the oak rule, the italic quote, the person and their cat.
 *
 * **With none, it renders nothing at all** — no heading over an empty space
 * and no "aún no hay testimonios". That is the deliberate exception to PAT-07,
 * recorded in the spec: a visitor gains nothing from being told there is no
 * praise yet.
 */
import Section from '../layout/Section.astro';
import Grid from '../layout/Grid.astro';
import Testimonial from '../ui/Testimonial.astro';
import type { LandingCopy } from '../../data/landing';
import { getTestimonials } from '../../data/testimonials';

interface Props {
  copy: LandingCopy['testimonials'];
}

const { copy } = Astro.props;
const items = await getTestimonials();
---

{
  items.length > 0 && (
    <Section data-block="testimonials">
      <Grid class="gap-y-10">
        <h2 class="col-span-12 text-h2 text-ink">{copy.headline}</h2>
        {items.map((item) => (
          <Testimonial name={item.name} cat={item.cat} class="col-span-12 md:col-span-6 lg:col-span-4">
            {item.quote}
          </Testimonial>
        ))}
      </Grid>
    </Section>
  )
}
