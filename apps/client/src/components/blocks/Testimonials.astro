---
/**
 * `block:testimonials` (spec 05, 05c): up to three testimonials from Sanity,
 * as guide §07 cards — the quote in Latin quotation marks, the person's
 * initials, their name and *Familia de …*.
 *
 * **With none, it renders nothing at all** — no heading over an empty space
 * and no "aún no hay testimonios". That is the deliberate exception to PAT-07,
 * recorded in spec 05: a visitor gains nothing from being told there is no
 * praise yet. Rendering nothing also takes it out of the colour rhythm, so the
 * bands either side of it never end up the same colour (`rhythm.ts`).
 *
 * From `lg`, two flowers lean in from the side margins behind the cards — a
 * línea-fina sprig on the left, a pressed yellow flower on the right: the
 * guide's maximum of two on a desktop screen, and none on a phone, where they
 * would sit over the quotes.
 */
import Section from '../layout/Section.astro';
import Grid from '../layout/Grid.astro';
import Flora from '../ui/Flora.astro';
import PressedFlower from '../ui/PressedFlower.astro';
import Testimonial from '../ui/Testimonial.astro';
import type { LandingCopy } from '../../data/landing';
import { getTestimonials } from '../../data/testimonials';
import { testimonialPlace, CAROUSEL_FROM } from './testimonials';

interface Props {
  copy: LandingCopy['testimonials'];
}

const { copy } = Astro.props;
const items = await getTestimonials();
const carousel = items.length > CAROUSEL_FROM;
---

{
  items.length > 0 && (
    <Section data-block="testimonials" edge class="isolate overflow-x-clip">
      <Flora
        line="sprig"
        class="absolute bottom-16 -left-28 -z-10 hidden w-[421.875px] -rotate-3 -scale-x-100 text-warning opacity-35 lg:block"
      />
      <PressedFlower
        name="yellow"
        sizes="(min-width: 1024px) 281px, 160px"
        class="absolute top-2 -right-20 z-20 hidden w-[280.8px] -rotate-6 opacity-80 lg:block"
      />
      <Grid class="gap-y-10">
        <div class="col-span-12 text-center md:col-span-8 md:col-start-3">
          <h2 class="text-h2 text-violet">{copy.headline}</h2>
          {copy.lead && <p class="mt-4 max-w-none text-lead text-graphite">{copy.lead}</p>}
        </div>
        {
          carousel ? (
            <div
              data-carousel
              role="region"
              aria-roledescription="carousel"
              aria-label="Testimonios"
              class="col-span-12"
            >
              {/* A track as wide as the 12 columns, its cards a share of it: the
                  gap is one of the grid's 23 units, so a card is 7 (three
                  across), 11 (two) or 23 (one) of them — the same spans the
                  static row uses. The vertical padding and its negative margin
                  keep the cards' shadow from being clipped. */}
              <div
                data-track
                tabindex="0"
                aria-label="Testimonios, desliza para ver más"
                class="relative -my-3 grid snap-x snap-mandatory auto-cols-[100%] grid-flow-col gap-x-[calc(100%/23)] overflow-x-auto overscroll-x-contain py-3 [scrollbar-width:none] md:auto-cols-[calc(100%*11/23)] lg:auto-cols-[calc(100%*7/23)] [&::-webkit-scrollbar]:hidden"
              >
                {items.map((item) => (
                  <Testimonial name={item.name} cat={item.cat} class="snap-start">
                    {item.quote}
                  </Testimonial>
                ))}
              </div>
              <div data-dots class="mt-6 flex justify-center gap-1" hidden />
              <template data-dot>
                <button
                  type="button"
                  class="group flex size-8 cursor-pointer items-center justify-center rounded-full"
                >
                  <span class="size-3 rounded-full bg-stone transition-colors duration-base group-aria-[current=true]:bg-violet" />
                </button>
              </template>
            </div>
          ) : (
            items.map((item, index) => (
              <Testimonial
                name={item.name}
                cat={item.cat}
                class={testimonialPlace(items.length, index)}
              >
                {item.quote}
              </Testimonial>
            ))
          )
        }
      </Grid>

      {/* Inside the band, and only when there is one: a script written outside
          is emitted in place in `astro dev`, between two bands (see Hero.astro). */}
      <script>
        import { initCarousel } from '../../lib/testimonials-carousel';

        for (const root of document.querySelectorAll<HTMLElement>('[data-block=testimonials] [data-carousel]')) {
          initCarousel(root);
        }
      </script>
    </Section>
  )
}
