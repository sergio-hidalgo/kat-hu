---
/**
 * `block:testimonials` (spec 05, 05c): up to three testimonials from Sanity,
 * as guide §07 cards — the quote in Latin quotation marks, the person's
 * initials, their name and *Familia de …*.
 *
 * **With none, it renders nothing at all** — no heading over an empty space
 * and no "aún no hay testimonios". That is the deliberate exception to PAT-07,
 * recorded in spec 05: a visitor gains nothing from being told there is no
 * praise yet. Rendering nothing also takes it out of the colour rhythm, so the
 * bands either side of it never end up the same colour (`rhythm.ts`).
 *
 * From `lg`, two flowers lean in from the side margins behind the cards — a
 * línea-fina sprig on the left, a pressed yellow flower on the right: the
 * guide's maximum of two on a desktop screen, and none on a phone, where they
 * would sit over the quotes.
 */
import Section from '../layout/Section.astro';
import Grid from '../layout/Grid.astro';
import Flora from '../ui/Flora.astro';
import PressedFlower from '../ui/PressedFlower.astro';
import Carousel from '../ui/Carousel.astro';
import Testimonial from '../ui/Testimonial.astro';
import type { LandingCopy } from '../../data/landing';
import { getTestimonials } from '../../data/testimonials';
import { testimonialPlace, CAROUSEL_FROM } from './testimonials';

interface Props {
  copy: LandingCopy['testimonials'];
}

const { copy } = Astro.props;
const items = await getTestimonials();
const carousel = items.length > CAROUSEL_FROM;
---

{
  items.length > 0 && (
    <Section data-block="testimonials" edge class="isolate overflow-x-clip">
      <Flora
        line="sprig"
        class="absolute bottom-16 -left-28 -z-10 hidden w-[421.875px] -rotate-3 -scale-x-100 text-warning opacity-35 phone-xl:left-auto phone-xl:-right-[16vw] phone-xl:block phone-xl:w-[64vw] phone-xl:rotate-3 phone-xl:scale-x-100 phone-md:left-auto phone-md:-right-[16vw] phone-md:block phone-md:w-[64vw] phone-md:rotate-3 phone-md:scale-x-100 tablet:left-auto tablet:-right-[10vw] tablet:block tablet:w-[40vw] tablet:rotate-3 tablet:scale-x-100 lg:block"
      />
      <PressedFlower
        name="yellow"
        sizes="(min-width: 1024px) 281px, 160px"
        class="absolute top-2 -right-20 z-20 hidden w-[280.8px] -rotate-6 opacity-80 lg:block"
      />
      <Grid class="gap-y-10">
        <div class="col-span-12 text-center md:col-span-8 md:col-start-3">
          <h2 class="text-h2 text-violet">{copy.headline}</h2>
          {copy.lead && <p class="mt-4 max-w-none text-lead text-graphite">{copy.lead}</p>}
        </div>
        {
          items.length > 1 ? (
            /* Below `lg` always a carousel of one (owner, 2026-10-04); from `lg`
               the row it was — or, past `CAROUSEL_FROM`, the carousel of three. */
            <Carousel
              label="Testimonios"
              autoplay
              scrollFrom={carousel ? 'always' : 'below-lg'}
              trackClass={
                carousel
                  ? 'lg:auto-cols-[calc(100%*7/23)]'
                  : 'lg:grid lg:grid-cols-12 lg:gap-x-[calc(100%/23)]'
              }
            >
              {items.map((item, index) => (
                <Testimonial
                  name={item.name}
                  cat={item.cat}
                  class:list={['snap-start', !carousel && testimonialPlace(items.length, index)]}
                >
                  {item.quote}
                </Testimonial>
              ))}
            </Carousel>
          ) : (
            <Testimonial name={items[0].name} cat={items[0].cat} class={testimonialPlace(1, 0)}>
              {items[0].quote}
            </Testimonial>
          )
        }
      </Grid>
    </Section>
  )
}
