---
/**
 * `block:about-teaser` (spec 05, 05c) — the Studio's «Terapeuta» tab: who the
 * florapeuta is, in a paragraph, and the way to the whole story. The title,
 * the text and the link (its words and its destination, a path on this site)
 * are the owner's to edit; each falls back to the code's default.
 *
 * The photo is a 4:5 crop in the guide's section-photo treatment — 8px radius
 * and the small shadow (guide §06). The owner can set one in the Studio
 * (`aboutTeaser.image`); until then it is Laura's portrait from the brand
 * assets, so the block always has its face.
 *
 * **Its size** (owner, 2026-09-28): 25% larger than the three columns it had
 * from `md`, which is 6¼ grid units — so it takes four columns and fills 25/28
 * of them, a width still counted in the grid's own units. The words keep
 * columns 5–11; column 12 stays free for the margin flowers.
 *
 * Flowers, never behind the words (guide §06): a pressed lilac over the
 * photo's bottom-left corner — mirrored, turned 72°, at 90% opacity and above
 * everything else in the band; the one flower a phone shows — and, from `xl`,
 * two línea-fina drawings in the right margin: the flower at the top and the
 * leaf at the bottom. Three on a desktop, one more than guide §06's two, by
 * the owner's request.
 *
 * The band is its own layer above the next one (`z-10`, which also keeps the
 * `-z-10` margin drawings behind its words): the process band now sits half
 * as far below (owner, 2026-09-28), and the pressed lilac hangs into it.
 */
import { Image } from 'astro:assets';
import Section from '../layout/Section.astro';
import Grid from '../layout/Grid.astro';
import Flora from '../ui/Flora.astro';
import PressedFlower from '../ui/PressedFlower.astro';
import { TEXT_LINK } from '../ui/link';
import type { LandingCopy } from '../../data/landing';
import { imageUrl } from '../../lib/sanity';
import portrait from '../../assets/brand/laura-portrait.png';

interface Props {
  copy: LandingCopy['about-teaser'];
}

const { copy } = Astro.props;
const { image } = copy;

const width = 640;
const height = 800;
const photoClass = 'block h-auto w-full shadow-sm md:w-[calc(100%*25/28)]';
---

<Section data-block="about-teaser" edge class="z-10 overflow-x-clip">
  <Flora line="flower" class="absolute top-0 -right-32 -z-10 hidden w-64 xl:block" />
  <Flora line="leaf" class="absolute bottom-0 -right-16 -z-10 hidden w-48 xl:block" />
  <Grid class="items-center gap-y-16">
    <div class="relative col-span-9 sm:col-span-6 md:col-span-4">
      {
        image ? (
          <img
            src={imageUrl(image).width(width).height(height).fit('crop').url()}
            alt={image.alt ?? ''}
            {width}
            {height}
            loading="lazy"
            decoding="async"
            class={photoClass}
          />
        ) : (
          <Image
            src={portrait}
            alt="Laura, la florapeuta de kathu, sonríe a la cámara en la puerta de su casa"
            {width}
            {height}
            fit="cover"
            widths={[320, 480, 640, 960]}
            sizes="(min-width: 760px) 25vw, (min-width: 480px) 44vw, 68vw"
            loading="lazy"
            class={photoClass}
          />
        )
      }
      <PressedFlower
        name="lilac"
        sizes="(min-width: 760px) 264px, 168px"
        class="absolute -bottom-6 -left-24 z-10 w-42 rotate-72 -scale-x-100 opacity-90 md:-bottom-24 md:-left-32 md:w-66"
      />
    </div>
    <div class="col-span-12 md:col-span-7 md:col-start-5">
      <h2 class="text-h2 text-violet">{copy.headline}</h2>
      <p class="mt-4 text-lead text-graphite">{copy.paragraph}</p>
      <a href={copy.linkHref} class:list={[TEXT_LINK, 'mt-4']}>{copy.linkLabel}</a>
    </div>
  </Grid>
</Section>
