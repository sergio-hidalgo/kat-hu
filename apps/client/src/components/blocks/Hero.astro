---
/**
 * `block:hero` — the landing's first screen (spec 05).
 *
 * **It fills the rest of the first screen: from just under the bar to the
 * bottom edge.** The page does not run it under the fixed chrome (no
 * `overHero`), so `<main>` already starts below the bar, and the hero's
 * minimum height is the screen minus that same chrome, read from `header.ts`.
 * `min-`, so on a very short screen the content pushes it taller rather than
 * overflowing. The photograph fills it with `object-cover`, trimming the sides
 * as the screen narrows (owner's requests of 2026-09-11).
 *
 * `sizes` describes that crop, not the viewport: the source is 2401×1058
 * (2.27:1), so on any screen narrower than that — every phone and most
 * desktops — it is laid out about 227vh wide, and `100vw` would hand out a
 * file far too small for it. It stops at 1920px and quality 60: the photo sits
 * under the violet tint, where neither costs anything visible, and on a phone
 * that is 143 KB instead of 324 KB for the page's largest paint (Lighthouse).
 *
 * Over the photograph: the violet-900 tint (guide §6); the four white corners,
 * drawn last so the bottom-right one sits on top of the picture; the words at the
 * **top** of the band, clear of the top corners, with **one decision** — the
 * page's single filled action, edged in white because its violet has no edge
 * against the tint (HIE-01, INT-02) — and *Cómo funciona* beside it as a text
 * link, only while that block is visible.
 *
 * **Laura with her cat** is part of the composition, not a portrait to crop
 * (owner, 2026-09-11/12): shown whole at its own 3:2, with no rounding (it is
 * a cut-out, and the 8px image radius would clip it), pinned to the band's
 * bottom-right edge with no margin. Like the full-bleed photo it is a direct
 * child of the band, outside the grid, so its size is a share of the screen —
 * 80% on a phone, 60% from `md`, half from `lg` — rather than columns. Below
 * `lg` it follows the words and `mt-auto` drops it to the bottom, so the band
 * grows instead of letting the two overlap; from `lg` it is taken out of the
 * flow and the words sit above it.
 */
import { Image } from 'astro:assets';
import Section from '../layout/Section.astro';
import Grid from '../layout/Grid.astro';
import Button from '../ui/Button.astro';
import CornerFrame from '../ui/CornerFrame.astro';
import { TEXT_LINK_ON_DARK } from '../ui/link';
import { BAND_SCREEN_MIN_H, CHROME_SCREEN_MIN_H } from '../site/header';
import { announcement } from '../../data/announcement';
import type { LandingCopy } from '../../data/landing';
import { isVisible, type Flags } from '../../lib/flags';
import lavender from '../../assets/brand/lavender_fields.png';
import together from '../../assets/brand/hero_together_bw.png';

interface Props {
  copy: LandingCopy['hero'];
  flags: Flags;
}

const { copy, flags } = Astro.props;

const screenMinH = announcement.enabled ? CHROME_SCREEN_MIN_H : BAND_SCREEN_MIN_H;
const howItWorks = isVisible(flags, 'block', 'how-it-works');
---

<Section
  padding="none"
  data-block="hero"
  class:list={['relative isolate flex flex-col', screenMinH]}
>
  <Image
    src={lavender}
    alt=""
    widths={[768, 1280, 1920]}
    sizes="(min-aspect-ratio: 227/100) 100vw, 227vh"
    quality={60}
    loading="eager"
    fetchpriority="high"
    class="absolute inset-0 -z-10 h-full w-full rounded-none object-cover"
  />
  {/* Guide §6: the violet-900 tint, never a lightened image with dark text. */}
  <div class="absolute inset-0 -z-10 bg-linear-to-t from-violet-900/80 to-violet-900/20">
  </div>
  {/* The top padding clears the top corners at each breakpoint (their box
      ends at 44px, 52px from `lg`, 68px at `2xl`) with a little air. */}
  <Grid class="relative z-10 pt-14 pb-8 md:pt-16 lg:pt-20 lg:pb-0 xl:pt-24">
    <div class="col-span-12 lg:col-span-7">
      <h1 class="text-display text-cloud">{copy.headline}</h1>
      <p class="mt-6 text-lead text-cloud">{copy.lead}</p>
      <div class="mt-8 flex flex-wrap items-center gap-x-6 gap-y-2">
        <Button href="/reservar" knockout>Reserva tu sesión</Button>
        {howItWorks && <a href="#como-funciona" class={TEXT_LINK_ON_DARK}>Cómo funciona</a>}
      </div>
    </div>
  </Grid>

  <Image
    src={together}
    alt="Laura, la florapeuta de kathu, sonríe junto a su gato"
    widths={[480, 768, 1024, 1536]}
    sizes="(min-width: 1024px) 50vw, (min-width: 768px) 60vw, 80vw"
    loading="eager"
    class="mt-auto h-auto w-4/5 self-end rounded-none md:w-3/5 lg:absolute lg:right-0 lg:bottom-0 lg:w-1/2"
  />

  {/* Drawn after the picture, so the bottom-right corner sits on top of it
      (owner, 2026-09-12): on a phone the picture is in the flow and any
      positioned box paints above it; from `lg` both are positioned and the
      later one wins. The words' grid stays above both (`z-10`). */}
  <CornerFrame top="top-0" />
</Section>
