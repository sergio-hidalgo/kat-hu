---
/**
 * A drop's main image wearing the banner's four light corners (spec 04c).
 *
 * The banner's photograph sits under a dark tint; a drop's does not, and a
 * light corner over a bright window or a pale wall disappears. So between the
 * image and the corners there is a tint of their own — Ink, the darkest
 * token since spec 05c (v1.5 used its darkest violet) — faint at the top
 * and bottom edges where the corners are, and clear through the middle where
 * the subject is: enough to give the corners a darker ground, not enough to
 * read as a filter (owner's decision of 2026-09-11).
 *
 * The image comes in through the slot, so the page keeps its own `src`, `alt`
 * and loading hints. The tint takes the image's 8px radius (`rounded`,
 * guide §6); square, its corners would show past the photo's rounded ones.
 */
import CornerFrame from '../ui/CornerFrame.astro';

interface Props {
  /** Placement only — a margin. */
  class?: string;
}

const { class: className } = Astro.props;
---

<div class:list={['relative', className]}>
  <slot />
  <div
    aria-hidden="true"
    data-image-tint
    class="pointer-events-none absolute inset-0 rounded bg-linear-to-b from-ink/30 via-ink/0 to-ink/30"
  >
  </div>
  <CornerFrame top="top-0" />
</div>
