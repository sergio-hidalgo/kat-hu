---
import { Heart } from '@lucide/astro';
import { DROP_TYPE_LABELS } from '@kat-hu/contracts';
import { formatDate, type Post } from '../../data/posts';
import { imageSet } from '../../lib/sanity';
import Card from '../ui/Card.astro';
import Chip from '../ui/Chip.astro';

type Props = Pick<Post, 'id' | 'slug' | 'title' | 'excerpt' | 'date' | 'mainImage' | 'dropType'> & {
  likes: number;
  /** How wide the card's picture is drawn, for the browser to pick a file. */
  sizes?: string;
};

/* /drops: one column under `md` (92vw of the screen: the grid's 23 of 25
   units), two to `lg` (11 units, 44vw) and three from it (7 units, 28vw). */
const DROPS_SIZES = '(min-width: 1024px) 28vw, (min-width: 760px) 44vw, 92vw';

const { id, slug, title, excerpt, date, mainImage, dropType, likes, sizes = DROPS_SIZES } = Astro.props;

const href = `/drops/${slug}/`;

/**
 * One crop for every card, featured or not: 16:9, the editorial ratio in guide
 * §6. The script moves cards between the two blocks as the column count
 * changes (issue I-006), so a card cannot have a shape that depends on where
 * it is — and one ratio is also what lets a masonry of varying-height cards
 * read as one set, the height coming from the text rather than the picture.
 */
const image = mainImage && imageSet(mainImage, { widths: [320, 480, 640, 800], ratio: 16 / 9 });
---

<Card
  interactive
  padded={false}
  class="relative flex flex-col overflow-hidden"
  data-post-id={id}
  data-date={date}
  data-likes={likes}
  data-drop-type={dropType}
>
  {
    mainImage ? (
      <a href={href} class="relative block leading-none">
        <img
          src={image!.src}
          srcset={image!.srcset}
          {sizes}
          alt={mainImage.alt ?? ''}
          loading="lazy"
          decoding="async"
          width={image!.width}
          height={image!.height}
          class="block h-auto w-full rounded-none"
        />
        {/* Bottom-right on a Crema scrim, so it stays legible on any photo. */}
        <span class="absolute right-2 bottom-2 inline-flex items-center gap-1 rounded-full bg-cream/92 px-2 py-1 text-xs text-ink tabular-nums">
          <Heart size={16} stroke-width={1.5} class="fill-error text-error" />
          <span class="like-count">{likes}</span>
        </span>
      </a>
    ) : null
  }

  {/* Two lines of title, five of summary: the card's height is capped in
      lines rather than in pixels, so it tracks the fluid type scale and the
      16:9 crop by itself. The browser's own ellipsis; the whole title and
      excerpt stay in the DOM for search and screen readers. Violeta rather
      than the guide's Ink, by the owner's decision (spec 04b). */}
  <div class="flex flex-1 flex-col p-6">
    <h3 class="line-clamp-2 text-h4 text-violet">
      <a href={href} class="no-underline hover:underline">{title}</a>
    </h3>

    <p class="mt-1.5 mb-3 flex max-w-none items-center gap-3 text-xs text-slate">
      <time datetime={date}>{formatDate(date, 'es-ES')}</time>
      {
        !mainImage && (
          <span class="inline-flex items-center gap-1 tabular-nums">
            <Heart size={16} stroke-width={1.5} class="fill-error text-error" />
            <span class="like-count">{likes}</span>
          </span>
        )
      }
    </p>

    <p class="line-clamp-5 max-w-none text-sm text-graphite">{excerpt}</p>

    {/* The kind of drop, last in the card (spec 05d). A label, not a link. */}
    <p class="mt-4 max-w-none">
      <Chip tone="type" kind={dropType} data-drop-badge>{DROP_TYPE_LABELS[dropType]}</Chip>
    </p>
  </div>
</Card>
