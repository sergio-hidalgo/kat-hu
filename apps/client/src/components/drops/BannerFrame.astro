---
/**
 * The classical frame around the `/drops` banner (specs 04b, 04c): the four
 * white corners of `CornerFrame`, in a box that starts **below** the chrome.
 *
 * The band runs under the fixed chrome (`overHero`), and at scroll 0 the band
 * is opaque Shell, so starting the box under it is what keeps the top corners
 * fully visible on first paint. That offset is a fact about the chrome and is
 * read from `header.ts`, never retyped (I-007).
 *
 * From `md` up the corners' side arms stay inside the 1-unit edge margin,
 * which is what lets the heading stay on column 1. Below `md` a unit is ~15px
 * and nothing legible fits, so there the page's padding clears the whole
 * corner instead.
 */
import CornerFrame from '../ui/CornerFrame.astro';
import { BAND_TOP, CHROME_TOP } from '../site/header';

interface Props {
  /** Whether the announcement stripe sits above the band. */
  stripe: boolean;
}

const { stripe } = Astro.props;
---

<CornerFrame top={stripe ? CHROME_TOP : BAND_TOP} data-banner-frame />
