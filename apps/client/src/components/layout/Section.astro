---
/**
 * A band across the page: vertical rhythm and a surface colour, nothing else.
 *
 * A Section is **always the full width of the screen**. It has no container
 * and no horizontal padding — the page margins belong to `Grid`, the single
 * grid everything is placed on (issue I-001). A Section that chose its own
 * width would be a second grid, which is exactly what this stopped being.
 *
 * Put a `<Grid>` inside for content. A full-bleed image is a direct child,
 * outside the Grid, because it is meant to reach the screen edges.
 *
 * `edge` makes the band part of guide §06's botanical rhythm: it can draw its
 * own silhouette over the foot of the band above (see `SectionEdge`). Whether
 * the silhouette shows, its colour, and whether a band keeps room at its foot
 * for the next band's silhouette are decided by the page from the bands that
 * actually render — on the landing, `blocks/rhythm.ts`.
 */
import type { HTMLTag } from 'astro/types';
import SectionEdge from '../ui/SectionEdge.astro';

type Padding = 'none' | 'sm' | 'lg';
type Surface = 'none' | 'cream' | 'lavender' | 'violet';

interface Props {
  /* Quoted: `as` unquoted trips the Astro compiler's props scanner, which then
     silently types `Astro.props` as `any`. */
  'as'?: HTMLTag;
  padding?: Padding;
  surface?: Surface;
  /** A botanical edge over the band above, and room for the next (guide §06). */
  edge?: boolean;
  /** Vertical placement and surface only. Never a width. */
  class?: string;
  [key: string]: unknown;
}

const {
  as: Tag = 'section',
  padding = 'lg',
  surface = 'none',
  edge = false,
  class: className,
  ...rest
} = Astro.props;

const paddings: Record<Padding, string> = {
  none: '',
  sm: 'py-10 md:py-12',
  lg: 'py-[clamp(4rem,7vw,7.5rem)]',
};

const surfaces: Record<Surface, string> = {
  none: '',
  cream: 'bg-cream text-graphite',
  lavender: 'bg-lavender text-graphite',
  violet: 'on-violet bg-violet text-cream',
};
---

<Tag
  class:list={[
    'w-full',
    surfaces[surface],
    paddings[padding],
    edge && 'relative',
    className,
  ]}
  {...rest}
>
  <slot />
  {edge && <SectionEdge />}
</Tag>
