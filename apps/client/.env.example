# From https://manage.sanity.io → your project → Project ID.
# These are not secrets: they appear in public image CDN URLs.
PUBLIC_SANITY_PROJECT_ID=your-project-id
PUBLIC_SANITY_DATASET=production
PUBLIC_SANITY_API_VERSION=2026-01-01

# Supabase — like counts. From the project's API settings.
# The publishable key is designed to be exposed in the browser; the table is
# read-only to it and writes go through the like_post/unlike_post RPCs.
PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx
