# apps/server — copy to .env and fill in. Never commit .env.
#
# All four are required: the process refuses to start on a missing or
# malformed value and names the variable (src/config/env.ts).

# Port the API listens on. The only variable with a default.
PORT=3000

# Comma-separated origins allowed to call this API from a browser.
# There is no wildcard — an unlisted origin gets no CORS header at all.
CLIENT_ORIGIN=http://localhost:4321

# Supabase project kat-hu.
SUPABASE_URL=https://laokeslruyqbcezjstij.supabase.co

# The service-role key. It bypasses RLS, so it lives ONLY in this file:
# never PUBLIC_-prefixed, never in apps/client or apps/studio, never logged.
# Dashboard → Project Settings → API keys → service_role.
SUPABASE_SECRET_KEY=
